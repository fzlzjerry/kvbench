+class QuantizerSmokeTests(unittest.TestCase):
+    def test_four_bit_nuq_fisher_smoke_is_finite(self) -> None:
+        quant_root = str(REPOSITORY_ROOT / "quant")
+        sys.path.insert(0, quant_root)
+        try:
+            from kvquant.simquant_module_quantizer import SimQuant
+            from kvquant_gqa.compat import (
+                build_quantizer_payload,
+                file_sha256,
+                load_fisher_smoke_artifact,
+            )
+            from safetensors.torch import save_file
+
+            layer = nn.Linear(16, 1024, bias=False, dtype=torch.bfloat16)
+            quantizer = SimQuant(layer, bits=4, perchannel=True, qchannel=-1)
+            output = torch.linspace(-3, 3, 8 * 1024).reshape(1, 8, 1024)
+            quantizer.add_batch(torch.zeros(1, 8, 16), output)
+            fisher_name = "model.layers.0.self_attn.k_proj.weight"
+            with tempfile.TemporaryDirectory() as directory:
+                fisher_path = Path(directory) / "fisher.safetensors"
+                fisher_payload = {
+                    f"model.layers.0.self_attn.{projection}.weight": torch.ones(
+                        1, 8, 1024, dtype=torch.float32
+                    )
+                    for projection in ("k_proj", "v_proj")
+                }
+                save_file(fisher_payload, str(fisher_path))
+                fisher = load_fisher_smoke_artifact(fisher_path)[fisher_name]
+                fisher_root = file_sha256(fisher_path)
+                result = quantizer.quantize(
