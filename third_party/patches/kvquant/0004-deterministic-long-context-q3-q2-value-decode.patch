+__global__ void VecQuant4MatMulKernelNUQPerChannelTransposedMHABatchedFusedOptDeterministicReduce(
+    const float* __restrict__ workspace,
+    float* __restrict__ mul,
+    int headdim,
+    int num_query_heads,
+    int num_tiles,
+    int workspace_tiles
+) {
+  const int channel = threadIdx.x;
+  const int query_head = blockIdx.x;
+  const int batch = blockIdx.y;
+  float total = 0.0f;
+
+  const int workspace_head_offset =
+      (batch * num_query_heads + query_head) * workspace_tiles * headdim;
+  for (int tile = 0; tile < num_tiles; ++tile) {
+    total += workspace[
+        workspace_head_offset + tile * headdim + channel
+    ];
+  }
+  mul[(batch * num_query_heads + query_head) * headdim + channel] = total;
+}
