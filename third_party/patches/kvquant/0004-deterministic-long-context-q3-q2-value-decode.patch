+                    repeated_mat,
+                    repeated_key_lut,
+                    value_lut,
+                    query,
+                    scores,
+                )
+                torch.testing.assert_close(
+                    native_key, reference_key, rtol=1e-5, atol=2e-4
+                )
+                torch.testing.assert_close(
+                    native_value, reference_value, rtol=1e-5, atol=2e-4
