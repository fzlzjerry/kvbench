+template <int BITS, int LEVELS, int PACKED_ROWS>
+__device__ __forceinline__ float VecQuantQ23DeterministicTilePartial(
+    const float* __restrict__ vec,
+    const int* __restrict__ mat,
+    const float* __restrict__ lookup_table,
+    const float* __restrict__ outliers,
+    const int* __restrict__ outlier_indices,
+    int width,
+    int fullwidth,
+    int headdim,
+    int num_query_heads,
+    int num_kv_groups,
+    int num_outliers,
+    int64_t vec_batch_stride,
+    int64_t vec_head_stride,
+    int batch,
+    int query_head,
+    int tile,
+    int channel
+) {
+  const int kv_head = query_head / num_kv_groups;
+  const int token_start = tile * BLOCKWIDTH;
+  const int token_stop = min(token_start + BLOCKWIDTH, width);
+  const int native_index = kv_head * headdim + channel;
+  const int bit_offset = channel * BITS;
+  const int packed_word = bit_offset / 32;
+  const int code_shift = bit_offset % 32;
+  const int packed_row = kv_head * PACKED_ROWS + packed_word;
+  float dense_partial = 0.0f;
+  float sparse_partial = 0.0f;
+
+  for (int token = token_start; token < token_stop; ++token) {
+    const float weight =
+        vec[batch * vec_batch_stride + query_head * vec_head_stride + token];
+    unsigned int code =
+        as_unsigned(mat[packed_row * fullwidth + token]) >> code_shift;
+    if (code_shift + BITS > 32) {
+      const unsigned int next =
+          as_unsigned(mat[(packed_row + 1) * fullwidth + token]);
+      code |= next << (32 - code_shift);
+    }
+    code &= (1u << BITS) - 1u;
+    dense_partial += weight * lookup_table[token * LEVELS + code];
+
+    const int sparse_offset = token * num_outliers;
+    for (int slot = 0; slot < num_outliers; ++slot) {
+      if (outlier_indices[sparse_offset + slot] == native_index) {
+        sparse_partial += weight * outliers[sparse_offset + slot];
+      }
+    }
+  }
+  return dense_partial + sparse_partial;
+}
