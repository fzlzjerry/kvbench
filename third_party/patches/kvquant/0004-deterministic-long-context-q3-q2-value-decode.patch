+__global__ void SelectFixedOutliers1024Cap12Kernel(
+    const float* __restrict__ values,
+    const float* __restrict__ lower_bounds,
+    const float* __restrict__ upper_bounds,
+    const bool* __restrict__ sink_mask,
+    float* __restrict__ selected_values,
+    int* __restrict__ selected_indices,
+    int* __restrict__ active_counts,
+    float* __restrict__ dense_lower_bounds,
+    float* __restrict__ dense_upper_bounds,
+    int rows,
+    int threshold_stride,
+    int mode) {
+  const int row = blockIdx.x;
+  if (row >= rows || threadIdx.x != 0) {
+    return;
+  }
+
+  float* row_values = selected_values + row * kSparseCapacity;
+  int* row_indices = selected_indices + row * kSparseCapacity;
+  for (int slot = 0; slot < kSparseCapacity; ++slot) {
+    row_values[slot] = 0.0f;
+    row_indices[slot] = 0;
+  }
+  active_counts[row] = 0;
+  dense_lower_bounds[row] = 0.0f;
+  dense_upper_bounds[row] = 0.0f;
+
+  const float* row_input = values + row * kMeasurementWidth;
+  if (sink_mask[row]) {
+    float dense_lower = FLT_MAX;
+    float dense_upper = -FLT_MAX;
+    for (int index = 0; index < kMeasurementWidth; ++index) {
+      const float value = row_input[index];
+      dense_lower = value < dense_lower ? value : dense_lower;
+      dense_upper = value > dense_upper ? value : dense_upper;
+    }
+    dense_lower_bounds[row] = dense_lower;
+    dense_upper_bounds[row] = dense_upper;
+    return;
+  }
+
+  const float* row_lower =
+      lower_bounds + (threshold_stride == 0 ? 0 : row * threshold_stride);
+  const float* row_upper =
+      upper_bounds + (threshold_stride == 0 ? 0 : row * threshold_stride);
+  int count = 0;
+
+  for (int tail_slot = 0; tail_slot < kEntriesPerTail; ++tail_slot) {
+    int best_index = -1;
+    float best_value = FLT_MAX;
+    for (int index = 0; index < kMeasurementWidth; ++index) {
+      if (already_selected(row_indices, count, index)) {
+        continue;
+      }
+      const float value = row_input[index];
+      const bool eligible =
+          mode == kValueFixedExtrema || value < row_lower[index];
+      if (!eligible) {
+        continue;
+      }
+      if (best_index < 0 || value < best_value ||
+          (value == best_value && index < best_index)) {
+        best_value = value;
+        best_index = index;
+      }
+    }
+    if (best_index < 0) {
+      break;
+    }
+    row_values[count] = best_value;
+    row_indices[count] = best_index;
+    ++count;
+  }
+
+  for (int tail_slot = 0; tail_slot < kEntriesPerTail; ++tail_slot) {
+    int best_index = -1;
+    float best_value = -FLT_MAX;
+    for (int index = 0; index < kMeasurementWidth; ++index) {
+      if (already_selected(row_indices, count, index)) {
+        continue;
+      }
+      const float value = row_input[index];
+      const bool eligible =
+          mode == kValueFixedExtrema || value > row_upper[index];
+      if (!eligible) {
+        continue;
+      }
+      if (best_index < 0 || value > best_value ||
+          (value == best_value && index < best_index)) {
+        best_value = value;
+        best_index = index;
+      }
+    }
+    if (best_index < 0) {
+      break;
+    }
+    row_values[count] = best_value;
+    row_indices[count] = best_index;
+    ++count;
+  }
+
+  float dense_lower = FLT_MAX;
+  float dense_upper = -FLT_MAX;
+  for (int index = 0; index < kMeasurementWidth; ++index) {
+    if (already_selected(row_indices, count, index)) {
+      continue;
+    }
+    const float value = row_input[index];
+    dense_lower = value < dense_lower ? value : dense_lower;
+    dense_upper = value > dense_upper ? value : dense_upper;
+  }
+  active_counts[row] = count;
+  dense_lower_bounds[row] = dense_lower;
+  dense_upper_bounds[row] = dense_upper;
+}
