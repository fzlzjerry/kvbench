+from __future__ import annotations
+
+import importlib
+import os
+import sys
+import unittest
+
+import torch
+
+
+RUN_PTX = os.environ.get("KVQUANT_RUN_PTX_TESTS") == "1"
+if RUN_PTX:
+    extension_dir = os.environ.get("KVQUANT_CUDA_EXTENSION_DIR")
+    if not extension_dir:
+        raise RuntimeError("KVQUANT_CUDA_EXTENSION_DIR is required for PTX tests")
+    sys.path.insert(0, extension_dir)
+    quant_cuda = importlib.import_module("quant_cuda")
+
+
+def _to_cuda(tensor: torch.Tensor) -> torch.Tensor:
+    """Use only runtime copies; CUDA_FORCE_PTX_JIT must not exercise torch kernels."""
+
+    return tensor.contiguous().to(device="cuda:0")
+
+
+def _llama3_inv_freq_cpu() -> torch.Tensor:
+    dim = 128
+    base_inv_freq = 1.0 / (
+        500000.0
+        ** (torch.arange(0, dim, 2, dtype=torch.float32) / dim)
+    )
+    wavelength = 2 * torch.pi / base_inv_freq
+    low_wavelength = 8192.0
+    high_wavelength = 2048.0
+    scaled = torch.where(
+        wavelength > low_wavelength, base_inv_freq / 8.0, base_inv_freq
+    )
+    smooth = (8192.0 / wavelength - 1.0) / 3.0
+    smoothed = (1.0 - smooth) * base_inv_freq / 8.0 + smooth * base_inv_freq
+    medium = (wavelength <= low_wavelength) & (wavelength >= high_wavelength)
+    return torch.where(medium, smoothed, scaled).contiguous()
+
+
+@unittest.skipUnless(
+    RUN_PTX and torch.cuda.is_available(),
+    "isolated CUDA_FORCE_PTX_JIT validation only",
+)
+class ForcedPtxJitTests(unittest.TestCase):
+    def test_dense_sparse_gqa_and_mha_4_3_2_execute_from_ptx(self) -> None:
+        head_dim = 128
+        sequence = 7
+        inv_freq = _to_cuda(_llama3_inv_freq_cpu())
+
+        for bits in (4, 3, 2):
+            with self.subTest(path="dense-gqa", bits=bits):
+                levels = 1 << bits
+                packed_rows = bits * head_dim // 32
+                mat = _to_cuda(
+                    torch.zeros(8, packed_rows, sequence, dtype=torch.int32)
+                )
+                key_lut = _to_cuda(torch.ones(8, head_dim, levels))
+                value_lut = _to_cuda(torch.ones(sequence, levels))
+                query = _to_cuda(torch.ones(1, 32, head_dim))
+                scores = _to_cuda(torch.ones(1, 32, sequence))
+                key_output = _to_cuda(torch.zeros(1, 32, sequence))
+                value_output = _to_cuda(torch.zeros(1, 32, head_dim))
+                getattr(
+                    quant_cuda,
+                    f"vecquant{bits}matmul_nuq_perchannel_transposed_rope_mha_batched_fused_opt",
+                )(
+                    query,
+                    mat,
+                    key_output,
+                    key_lut,
+                    sequence,
+                    inv_freq,
+                    5,
+                )
+                getattr(
+                    quant_cuda,
+                    f"vecquant{bits}matmul_nuq_perchannel_transposed_mha_batched_fused_opt",
+                )(
+                    scores,
+                    mat,
+                    value_output,
+                    value_lut,
+                    sequence,
+                )
+                torch.cuda.synchronize()
+                key_cpu = key_output.cpu()
+                value_cpu = value_output.cpu()
+                self.assertTrue(torch.isfinite(key_cpu).all().item())
+                self.assertGreater(torch.count_nonzero(key_cpu).item(), 0)
+                torch.testing.assert_close(
+                    value_cpu,
+                    torch.full_like(value_cpu, float(sequence)),
+                    rtol=0.0,
+                    atol=0.0,
+                )
+
+            with self.subTest(path="sparse-gqa", bits=bits):
+                zero_key_lut = _to_cuda(torch.zeros(8, head_dim, levels))
+                zero_value_lut = _to_cuda(torch.zeros(sequence, levels))
+                outlier_values = _to_cuda(torch.ones(sequence, 12))
+                outlier_indices_cpu = torch.empty(
+                    sequence, 12, dtype=torch.int32
+                )
+                for token in range(sequence):
+                    kv_head = token % 8
+                    outlier_indices_cpu[token] = (
+                        kv_head * head_dim
+                        + torch.arange(12, dtype=torch.int32)
+                    )
+                outlier_indices = _to_cuda(outlier_indices_cpu)
+                sparse_key_output = _to_cuda(torch.zeros(1, 32, sequence))
+                sparse_value_output = _to_cuda(torch.zeros(1, 32, head_dim))
+                getattr(
+                    quant_cuda,
+                    f"vecquant{bits}matmul_nuq_perchannel_transposed_rope_mha_batched_fused_opt2",
+                )(
+                    query,
+                    mat,
+                    sparse_key_output,
+                    zero_key_lut,
+                    sequence,
+                    outlier_values,
+                    outlier_indices,
+                    inv_freq,
+                    5,
+                )
+                getattr(
+                    quant_cuda,
+                    f"vecquant{bits}matmul_nuq_perchannel_transposed_mha_batched_fused_opt2",
+                )(
+                    scores,
+                    mat,
+                    sparse_value_output,
+                    zero_value_lut,
+                    sequence,
+                    outlier_values,
+                    outlier_indices,
+                )
+                torch.cuda.synchronize()
+                for output in (sparse_key_output.cpu(), sparse_value_output.cpu()):
+                    self.assertTrue(torch.isfinite(output).all().item())
+                    self.assertGreater(torch.count_nonzero(output).item(), 0)
+
+            with self.subTest(path="dense-mha", bits=bits):
+                mha_mat = _to_cuda(
+                    torch.zeros(2, packed_rows, sequence, dtype=torch.int32)
+                )
+                mha_key_lut = _to_cuda(torch.ones(2, head_dim, levels))
+                mha_query = _to_cuda(torch.ones(1, 2, head_dim))
+                mha_scores = _to_cuda(torch.ones(1, 2, sequence))
+                mha_key_output = _to_cuda(torch.zeros(1, 2, sequence))
+                mha_value_output = _to_cuda(torch.zeros(1, 2, head_dim))
+                getattr(
+                    quant_cuda,
+                    f"vecquant{bits}matmul_nuq_perchannel_transposed_rope_mha_batched_fused_opt",
+                )(
+                    mha_query,
+                    mha_mat,
+                    mha_key_output,
+                    mha_key_lut,
+                    sequence,
+                    inv_freq,
+                    5,
+                )
+                getattr(
+                    quant_cuda,
+                    f"vecquant{bits}matmul_nuq_perchannel_transposed_mha_batched_fused_opt",
+                )(
+                    mha_scores,
+                    mha_mat,
+                    mha_value_output,
+                    value_lut,
+                    sequence,
+                )
+                torch.cuda.synchronize()
+                self.assertGreater(
+                    torch.count_nonzero(mha_key_output.cpu()).item(), 0
+                )
+                torch.testing.assert_close(
+                    mha_value_output.cpu(),
+                    torch.full((1, 2, head_dim), float(sequence)),
+                    rtol=0.0,
+                    atol=0.0,
+                )
+
+
+if __name__ == "__main__":
+    unittest.main()
