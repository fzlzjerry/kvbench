+__global__ void WriteKeySparseResidual1024Cap12Kernel(
+    const float* __restrict__ source_values,
+    const float* __restrict__ lookup_table,
+    const float* __restrict__ selected_scores,
+    const int* __restrict__ selected_indices,
+    const int* __restrict__ active_counts,
+    float* __restrict__ sparse_values,
+    int* __restrict__ sparse_indices,
+    int* __restrict__ sparse_counts,
+    int rows,
+    int levels,
+    int cache_offset) {
+  const int linear = blockIdx.x * blockDim.x + threadIdx.x;
+  const int total = rows * kSparseCapacity;
+  if (linear >= total) {
+    return;
+  }
+  const int row = linear / kSparseCapacity;
+  const int slot = linear % kSparseCapacity;
+  const int output_row = cache_offset + row;
+  const int output_offset = output_row * kSparseCapacity + slot;
+  const int count = active_counts[row];
+  if (slot < count) {
+    const int native_index = selected_indices[linear];
+    const float nearest =
+        selected_scores[linear] < 0.0f
+        ? lookup_table[native_index * levels]
+        : lookup_table[native_index * levels + levels - 1];
+    sparse_values[output_offset] =
+        source_values[row * kMeasurementWidth + native_index] - nearest;
+    sparse_indices[output_offset] = native_index;
+  } else {
+    sparse_values[output_offset] = 0.0f;
+    sparse_indices[output_offset] = 0;
+  }
+  if (slot == 0) {
+    sparse_counts[output_row] = count;
+  }
+}
+
+__global__ void WriteValueSparseResidual1024Cap12Kernel(
+    const float* __restrict__ selected_values,
+    const int* __restrict__ selected_indices,
+    const int* __restrict__ active_counts,
+    const float* __restrict__ zero_points,
+    float* __restrict__ sparse_values,
+    int* __restrict__ sparse_indices,
+    int* __restrict__ sparse_counts,
+    int rows,
+    int cache_offset) {
+  const int linear = blockIdx.x * blockDim.x + threadIdx.x;
+  const int total = rows * kSparseCapacity;
+  if (linear >= total) {
+    return;
+  }
+  const int row = linear / kSparseCapacity;
+  const int slot = linear % kSparseCapacity;
+  const int output_row = cache_offset + row;
+  const int output_offset = output_row * kSparseCapacity + slot;
+  const int count = active_counts[row];
+  if (slot < count) {
+    sparse_values[output_offset] =
+        selected_values[linear] - zero_points[row];
+    sparse_indices[output_offset] = selected_indices[linear];
+  } else {
+    sparse_values[output_offset] = 0.0f;
+    sparse_indices[output_offset] = 0;
+  }
+  if (slot == 0) {
+    sparse_counts[output_row] = count;
+  }
+}
+
+__global__ void ClearValuePackedColumnKernel(
+    int* __restrict__ mat,
+    int packed_rows,
+    int fullwidth,
+    int cache_index) {
+  const int linear = blockIdx.x * blockDim.x + threadIdx.x;
+  const int total = kNumKvHeads * packed_rows;
+  if (linear < total) {
+    mat[linear * fullwidth + cache_index] = 0;
+  }
+}
+
+__global__ void WriteValueMetadataAndSparseKernel(
+    float* __restrict__ lookup_cache,
+    const float* __restrict__ metadata_row,
+    const float* __restrict__ zero_point,
+    const float* __restrict__ selected_values,
+    const int* __restrict__ selected_indices,
+    const int* __restrict__ selected_count,
+    float* __restrict__ sparse_values,
+    int* __restrict__ sparse_indices,
+    int* __restrict__ sparse_counts,
+    int levels,
+    int cache_index) {
+  const int slot = blockIdx.x * blockDim.x + threadIdx.x;
+  if (slot < levels) {
+    lookup_cache[cache_index * levels + slot] = metadata_row[slot];
+  }
+  if (slot < kSparseCapacity) {
+    const int count = selected_count[0];
+    const int output_offset = cache_index * kSparseCapacity + slot;
+    if (slot < count) {
+      sparse_values[output_offset] =
+          selected_values[slot] - zero_point[0];
+      sparse_indices[output_offset] = selected_indices[slot];
+    } else {
+      sparse_values[output_offset] = 0.0f;
+      sparse_indices[output_offset] = 0;
+    }
+    if (slot == 0) {
+      sparse_counts[cache_index] = count;
+    }
+  }
+}
+
+__global__ void AppendValueSparseDeviceOutKernel(
+    int* __restrict__ mat,
+    const float* __restrict__ metadata_row,
+    const float* __restrict__ newvec,
+    const float* __restrict__ lower_bound,
+    const float* __restrict__ upper_bound,
+    int bits,
+    int levels,
+    int packed_rows,
+    int fullwidth,
+    int cache_index) {
+  const int native_index = blockIdx.x * blockDim.x + threadIdx.x;
+  if (native_index >= kMeasurementWidth) {
+    return;
+  }
+  const float value = newvec[native_index];
+  int code = 0;
+  if (value < lower_bound[0] || value > upper_bound[0]) {
+    code = bits == 4 ? 7 : (bits == 3 ? 3 : 1);
+  } else {
+    float best_distance = fabsf(metadata_row[0] - value);
+    for (int candidate = 1; candidate < levels; ++candidate) {
+      const float distance = fabsf(metadata_row[candidate] - value);
+      if (distance < best_distance) {
+        best_distance = distance;
+        code = candidate;
+      }
+    }
+  }
+
+  const int head = native_index / kHeadDim;
+  const int channel = native_index % kHeadDim;
+  const int bit_offset = channel * bits;
+  const int word = bit_offset / 32;
+  const int shift = bit_offset % 32;
+  unsigned int* packed = reinterpret_cast<unsigned int*>(mat);
+  const int output = (head * packed_rows + word) * fullwidth + cache_index;
+  atomicOr(packed + output, static_cast<unsigned int>(code) << shift);
+  if (shift + bits > 32) {
+    const int following =
+        (head * packed_rows + word + 1) * fullwidth + cache_index;
+    atomicOr(
+        packed + following,
+        static_cast<unsigned int>(code) >> (32 - shift));
+  }
+}
