+__global__ void VecQuant4MatMulKernelNUQPerChannelTransposedMHABatchedFusedOptDeterministicTiles(
+    const float* __restrict__ vec,
+    const int* __restrict__ mat,
+    const float* __restrict__ lookup_table,
+    const float* __restrict__ outliers,
+    const int* __restrict__ outlier_indices,
+    float* __restrict__ workspace,
+    int width,
+    int fullwidth,
+    int headdim,
+    int packed_rows,
+    int num_query_heads,
+    int num_kv_groups,
+    int num_outliers,
+    int workspace_tiles
+) {
+  const int channel = threadIdx.x;
+  const int tile = blockIdx.x;
+  const int query_head = blockIdx.y;
+  const int batch = blockIdx.z;
+  const int kv_head = query_head / num_kv_groups;
+  const int token_start = tile * BLOCKWIDTH;
+  const int token_stop = min(token_start + BLOCKWIDTH, width);
+  const int native_index = kv_head * headdim + channel;
+  const int packed_row = kv_head * packed_rows + channel / 8;
+  const int code_shift = 4 * (channel % 8);
+  const int vec_batch_offset = batch * num_query_heads * width;
+  float dense_partial = 0.0f;
+  float sparse_partial = 0.0f;
+
+  for (int token = token_start; token < token_stop; ++token) {
+    const float weight =
+        vec[vec_batch_offset + query_head * width + token];
+    const unsigned int packed =
+        as_unsigned(mat[packed_row * fullwidth + token]);
+    const int code = (packed >> code_shift) & 0xf;
+    dense_partial += weight * lookup_table[token * 16 + code];
+
+    const int sparse_offset = token * num_outliers;
+    for (int slot = 0; slot < num_outliers; ++slot) {
+      if (outlier_indices[sparse_offset + slot] == native_index) {
+        sparse_partial += weight * outliers[sparse_offset + slot];
+      }
+    }
+  }
+
+  const int workspace_offset =
+      ((batch * num_query_heads + query_head) * workspace_tiles + tile) *
+          headdim +
+      channel;
+  workspace[workspace_offset] = dense_partial + sparse_partial;
+}
