+
+void select_fixed_outliers_1024_cap12_out_cuda(
+    torch::Tensor values,
+    torch::Tensor lower_bounds,
+    torch::Tensor upper_bounds,
+    torch::Tensor sink_mask,
+    torch::Tensor selected_values,
+    torch::Tensor selected_indices,
+    torch::Tensor active_counts,
+    torch::Tensor dense_lower_bounds,
+    torch::Tensor dense_upper_bounds,
+    int mode) {
+  check_cuda_contiguous(values, "values");
+  check_cuda_contiguous(lower_bounds, "lower_bounds");
+  check_cuda_contiguous(upper_bounds, "upper_bounds");
+  check_cuda_contiguous(sink_mask, "sink_mask");
+  check_cuda_contiguous(selected_values, "selected_values");
+  check_cuda_contiguous(selected_indices, "selected_indices");
+  check_cuda_contiguous(active_counts, "active_counts");
+  check_cuda_contiguous(dense_lower_bounds, "dense_lower_bounds");
+  check_cuda_contiguous(dense_upper_bounds, "dense_upper_bounds");
+  TORCH_CHECK(values.scalar_type() == torch::kFloat32, "values must be float32");
+  TORCH_CHECK(
+      lower_bounds.scalar_type() == torch::kFloat32 &&
+      upper_bounds.scalar_type() == torch::kFloat32,
+      "threshold bounds must be float32");
+  TORCH_CHECK(sink_mask.scalar_type() == torch::kBool, "sink_mask must be bool");
+  TORCH_CHECK(
+      selected_values.scalar_type() == torch::kFloat32,
+      "selected_values must be float32");
+  TORCH_CHECK(
+      selected_indices.scalar_type() == torch::kInt32,
+      "selected_indices must be int32");
+  TORCH_CHECK(
+      active_counts.scalar_type() == torch::kInt32,
+      "active_counts must be int32");
+  TORCH_CHECK(
+      dense_lower_bounds.scalar_type() == torch::kFloat32 &&
+      dense_upper_bounds.scalar_type() == torch::kFloat32,
+      "dense bounds must be float32");
+  TORCH_CHECK(
+      values.dim() == 2 && values.size(1) == kMeasurementWidth,
+      "values must have shape [rows, 1024]");
+  const int rows = values.size(0);
+  TORCH_CHECK(
+      lower_bounds.numel() == kMeasurementWidth ||
+      lower_bounds.numel() == rows * kMeasurementWidth,
+      "lower_bounds must have 1024 or rows*1024 elements");
+  TORCH_CHECK(
+      upper_bounds.numel() == lower_bounds.numel(),
+      "upper_bounds must match lower_bounds");
+  TORCH_CHECK(sink_mask.numel() == rows, "sink_mask must have one entry per row");
+  TORCH_CHECK(
+      selected_values.sizes() == torch::IntArrayRef({rows, kSparseCapacity}),
+      "selected_values must have shape [rows, 12]");
+  TORCH_CHECK(
+      selected_indices.sizes() == torch::IntArrayRef({rows, kSparseCapacity}),
+      "selected_indices must have shape [rows, 12]");
+  TORCH_CHECK(active_counts.numel() == rows, "active_counts shape mismatch");
+  TORCH_CHECK(
+      dense_lower_bounds.numel() == rows &&
+      dense_upper_bounds.numel() == rows,
+      "dense bounds shape mismatch");
+  TORCH_CHECK(
+      mode == kKeyThresholded || mode == kValueFixedExtrema,
+      "mode must be 0 (Key) or 1 (Value)");
+  for (const auto* item : {
+           &lower_bounds,
+           &upper_bounds,
+           &sink_mask,
+           &selected_values,
+           &selected_indices,
+           &active_counts,
+           &dense_lower_bounds,
+           &dense_upper_bounds}) {
+    check_same_device(values, *item, "selector tensor");
+  }
+  const int threshold_stride =
+      lower_bounds.numel() == kMeasurementWidth ? 0 : kMeasurementWidth;
+  SelectFixedOutliers1024Cap12Kernel<<<
+      rows,
+      1,
+      0,
+      at::cuda::getCurrentCUDAStream()>>>(
+      values.data_ptr<float>(),
+      lower_bounds.data_ptr<float>(),
+      upper_bounds.data_ptr<float>(),
+      sink_mask.data_ptr<bool>(),
+      selected_values.data_ptr<float>(),
+      selected_indices.data_ptr<int>(),
+      active_counts.data_ptr<int>(),
+      dense_lower_bounds.data_ptr<float>(),
+      dense_upper_bounds.data_ptr<float>(),
+      rows,
+      threshold_stride,
+      mode);
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+void key_sparse_residual_1024_cap12_out_cuda(
+    torch::Tensor source_values,
+    torch::Tensor lookup_table,
+    torch::Tensor selected_scores,
+    torch::Tensor selected_indices,
+    torch::Tensor active_counts,
+    torch::Tensor sparse_values,
+    torch::Tensor sparse_indices,
+    torch::Tensor sparse_counts,
+    int cache_offset,
+    int bits) {
+  check_cuda_contiguous(source_values, "source_values");
+  check_cuda_contiguous(lookup_table, "lookup_table");
+  check_cuda_contiguous(selected_scores, "selected_scores");
+  check_cuda_contiguous(selected_indices, "selected_indices");
+  check_cuda_contiguous(active_counts, "active_counts");
+  check_cuda_contiguous(sparse_values, "sparse_values");
+  check_cuda_contiguous(sparse_indices, "sparse_indices");
+  check_cuda_contiguous(sparse_counts, "sparse_counts");
+  TORCH_CHECK(bits == 2 || bits == 3 || bits == 4, "bits must be 2, 3, or 4");
+  const int levels = 1 << bits;
+  TORCH_CHECK(
+      source_values.scalar_type() == torch::kFloat32 &&
+      lookup_table.scalar_type() == torch::kFloat32 &&
+      selected_scores.scalar_type() == torch::kFloat32 &&
+      sparse_values.scalar_type() == torch::kFloat32,
+      "Key values and lookup tensors must be float32");
+  TORCH_CHECK(
+      selected_indices.scalar_type() == torch::kInt32 &&
+      active_counts.scalar_type() == torch::kInt32 &&
+      sparse_indices.scalar_type() == torch::kInt32 &&
+      sparse_counts.scalar_type() == torch::kInt32,
+      "Key indices and counts must be int32");
+  TORCH_CHECK(
+      source_values.dim() == 2 &&
+      source_values.size(1) == kMeasurementWidth,
+      "source_values must have shape [rows, 1024]");
+  const int rows = source_values.size(0);
+  TORCH_CHECK(
+      lookup_table.numel() == kMeasurementWidth * levels,
+      "lookup_table size mismatch");
+  TORCH_CHECK(
+      selected_scores.sizes() ==
+          torch::IntArrayRef({rows, kSparseCapacity}) &&
+      selected_indices.sizes() ==
+          torch::IntArrayRef({rows, kSparseCapacity}),
+      "selected Key tensors must have shape [rows, 12]");
+  TORCH_CHECK(active_counts.numel() == rows, "active_counts shape mismatch");
+  TORCH_CHECK(
+      sparse_values.dim() == 2 &&
+      sparse_values.size(1) == kSparseCapacity &&
+      sparse_indices.sizes() == sparse_values.sizes(),
+      "sparse caches must have shape [capacity, 12]");
+  TORCH_CHECK(
+      cache_offset >= 0 &&
+      cache_offset + rows <= sparse_values.size(0) &&
+      sparse_counts.numel() >= cache_offset + rows,
+      "Key sparse cache range is out of bounds");
+  for (const auto* item : {
+           &lookup_table,
+           &selected_scores,
+           &selected_indices,
+           &active_counts,
+           &sparse_values,
+           &sparse_indices,
+           &sparse_counts}) {
+    check_same_device(source_values, *item, "Key sparse tensor");
+  }
+  constexpr int threads = 128;
+  const int total = rows * kSparseCapacity;
+  WriteKeySparseResidual1024Cap12Kernel<<<
+      (total + threads - 1) / threads,
+      threads,
+      0,
+      at::cuda::getCurrentCUDAStream()>>>(
+      source_values.data_ptr<float>(),
+      lookup_table.data_ptr<float>(),
+      selected_scores.data_ptr<float>(),
+      selected_indices.data_ptr<int>(),
+      active_counts.data_ptr<int>(),
+      sparse_values.data_ptr<float>(),
+      sparse_indices.data_ptr<int>(),
+      sparse_counts.data_ptr<int>(),
+      rows,
+      levels,
+      cache_offset);
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
