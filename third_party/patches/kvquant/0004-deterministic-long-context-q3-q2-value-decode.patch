+#!/usr/bin/env python3
+"""Narrow Phase 11P validation for the graph-safe KVQuant CUDA APIs."""
+
+from __future__ import annotations
+
+import argparse
+import gc
+import importlib
+import json
+import struct
+from pathlib import Path
+
+import torch
+
+
+WIDTH = 1024
+CAP = 12
+SINK = 5
+STORE = 17
+TOTAL = 18
+QUANTIZED = TOTAL - SINK
+STORE_QUANTIZED = STORE - SINK
+HEAD_DIM = 128
+KV_HEADS = 8
+QUERY_HEADS = 32
+GROUPS = 4
+
+DTYPES = {
+    "BOOL": torch.bool,
+    "F16": torch.float16,
+    "BF16": torch.bfloat16,
+    "F32": torch.float32,
+    "I32": torch.int32,
+    "I64": torch.int64,
+}
+
+
+def load_safetensors(path: Path) -> dict[str, torch.Tensor]:
+    payload = path.read_bytes()
+    header_size = struct.unpack("<Q", payload[:8])[0]
+    header = json.loads(payload[8 : 8 + header_size])
+    data_start = 8 + header_size
+    tensors: dict[str, torch.Tensor] = {}
+    for name, record in header.items():
+        if name == "__metadata__":
+            continue
+        start, stop = record["data_offsets"]
+        storage = bytearray(payload[data_start + start : data_start + stop])
+        tensor = torch.frombuffer(
+            storage,
+            dtype=DTYPES[record["dtype"]],
+        ).clone()
+        tensors[name] = tensor.reshape(record["shape"])
+    return tensors
+
+
+def fixture_payload(case_dir: Path) -> dict[str, dict[str, torch.Tensor]]:
+    return {
+        name: load_safetensors(case_dir / name)
+        for name in (
+            "inputs.safetensors",
+            "dense_payload.safetensors",
+            "metadata.safetensors",
+            "sparse_values.safetensors",
+            "sparse_indices.safetensors",
+            "sink.safetensors",
+            "store_state.safetensors",
+            "append_state.safetensors",
+            "decode_output.safetensors",
+        )
+    }
+
+
+def cuda(tensor: torch.Tensor) -> torch.Tensor:
+    return tensor.contiguous().to(device="cuda")
+
+
+def assert_equal(actual: torch.Tensor, expected: torch.Tensor, label: str) -> None:
+    expected_cuda = cuda(expected)
+    if not torch.equal(actual, expected_cuda):
+        mismatch = int(torch.count_nonzero(actual != expected_cuda).item())
+        raise AssertionError(f"{label}: exact mismatch ({mismatch} elements)")
+
+
+def selector_outputs(
+    quant_cuda,
+    values: torch.Tensor,
+    lower: torch.Tensor,
+    upper: torch.Tensor,
+    sink_mask: torch.Tensor,
+    mode: int,
+) -> tuple[torch.Tensor, ...]:
+    rows = values.shape[0]
+    selected_values = torch.empty((rows, CAP), dtype=torch.float32, device="cuda")
+    selected_indices = torch.empty((rows, CAP), dtype=torch.int32, device="cuda")
+    counts = torch.empty(rows, dtype=torch.int32, device="cuda")
+    dense_lower = torch.empty(rows, dtype=torch.float32, device="cuda")
+    dense_upper = torch.empty(rows, dtype=torch.float32, device="cuda")
+    quant_cuda.select_fixed_outliers_1024_cap12_out(
+        values,
+        lower,
+        upper,
+        sink_mask,
+        selected_values,
+        selected_indices,
+        counts,
+        dense_lower,
+        dense_upper,
+        mode,
+    )
+    return selected_values, selected_indices, counts, dense_lower, dense_upper
+
+
+def normalized_key_rows(
+    inputs: dict[str, torch.Tensor],
+    metadata: dict[str, torch.Tensor],
+) -> tuple[torch.Tensor, torch.Tensor]:
+    key_rows = (
+        cuda(inputs["key_pre_rope"])[0]
+        .transpose(0, 1)
+        .reshape(TOTAL, WIDTH)
+        .float()
+        .contiguous()
+    )
+    lower = cuda(metadata["key_runtime_lower_threshold"]).reshape(WIDTH)
+    upper = cuda(metadata["key_runtime_upper_threshold"]).reshape(WIDTH)
+    midpoint = (upper + lower) / 2.0
+    half_range = (upper - lower) / 2.0
+    return key_rows, ((key_rows - midpoint) / half_range).contiguous()
+
+
+def value_rows(inputs: dict[str, torch.Tensor]) -> torch.Tensor:
+    return (
+        cuda(inputs["value_after_v_proj"])[0]
+        .transpose(0, 1)
+        .reshape(TOTAL, WIDTH)
+        .float()
+        .contiguous()
+    )
+
+
+def run_selector_checks(
+    quant_cuda,
+    payload: dict[str, dict[str, torch.Tensor]],
+    label: str,
+) -> dict[str, torch.Tensor]:
+    inputs = payload["inputs.safetensors"]
+    metadata = payload["metadata.safetensors"]
+    sparse_values = payload["sparse_values.safetensors"]
+    sparse_indices = payload["sparse_indices.safetensors"]
+    key_rows, key_normalized = normalized_key_rows(inputs, metadata)
+    sink_mask = torch.arange(TOTAL, device="cuda") < SINK
+    minus_one = torch.full((WIDTH,), -1.0, device="cuda")
+    plus_one = torch.full((WIDTH,), 1.0, device="cuda")
+    key = selector_outputs(
+        quant_cuda,
+        key_normalized,
+        minus_one,
+        plus_one,
+        sink_mask,
+        0,
+    )
+    assert_equal(
+        key[0],
+        sparse_values["key_selection_normalized_by_position"],
+        f"{label} Key selected values",
+    )
+    assert_equal(
+        key[1],
+        sparse_indices["key_selection_by_position"],
+        f"{label} Key selected indices",
+    )
+    assert_equal(
+        key[2],
+        sparse_indices["key_active_count_by_position"],
+        f"{label} Key active counts",
+    )
+
+    rows = value_rows(inputs)
+    dummy = torch.zeros(WIDTH, dtype=torch.float32, device="cuda")
+    value = selector_outputs(
+        quant_cuda,
+        rows,
+        dummy,
+        dummy,
+        sink_mask,
+        1,
+    )
+    assert_equal(
+        value[0],
+        sparse_values["value_selection_by_position"],
+        f"{label} Value selected values",
+    )
+    assert_equal(
+        value[1],
+        sparse_indices["value_selection_by_position"],
+        f"{label} Value selected indices",
+    )
+    assert_equal(
+        value[2],
+        sparse_indices["value_active_count_by_position"],
+        f"{label} Value active counts",
+    )
+    assert_equal(
+        value[3],
+        metadata["value_dense_lower_bound"],
+        f"{label} Value dense lower",
+    )
+    assert_equal(
+        value[4],
+        metadata["value_dense_upper_bound"],
+        f"{label} Value dense upper",
+    )
+
+    tie_rows = cuda(inputs["value_tie_control_rows"]).float()
+    tie_mask = cuda(inputs["value_tie_control_sink_mask"])
+    tie = selector_outputs(
+        quant_cuda,
+        tie_rows,
+        dummy,
+        dummy,
+        tie_mask,
+        1,
+    )
+    assert_equal(
+        tie[0],
+        sparse_values["value_tie_control"],
+        f"{label} Value tie values",
+    )
+    assert_equal(
+        tie[1],
+        sparse_indices["value_tie_control"],
+        f"{label} Value tie indices",
+    )
+    assert_equal(
+        tie[2],
+        sparse_indices["value_tie_control_counts"],
+        f"{label} Value tie counts",
+    )
+    return {
+        "key_rows": key_rows,
+        "key_normalized": key_normalized,
+        "key_selected_values": key[0],
+        "key_selected_indices": key[1],
+        "key_counts": key[2],
+        "value_rows": rows,
+        "value_selected_values": value[0],
+        "value_selected_indices": value[1],
+        "value_counts": value[2],
+        "value_dense_lower": value[3],
+        "value_dense_upper": value[4],
+    }
+
+
+def run_fixture_case(
+    quant_cuda,
+    case_dir: Path,
+    family: str,
+    case_name: str,
+) -> None:
+    bits = int(family[-1])
+    levels = 1 << bits
+    packed_rows = bits * HEAD_DIM // 32
+    label = f"{family}/{case_name}"
+    payload = fixture_payload(case_dir)
+    selected = run_selector_checks(quant_cuda, payload, label)
+    metadata = payload["metadata.safetensors"]
