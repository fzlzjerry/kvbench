+template <int BITS, int LEVELS, int PACKED_ROWS>
+__global__ void VecQuantQ23MatMulKernelNUQPerChannelTransposedMHABatchedFusedOptDeterministicReduce(
+    const float* __restrict__ vec,
+    const int* __restrict__ mat,
+    const float* __restrict__ lookup_table,
+    const float* __restrict__ outliers,
+    const int* __restrict__ outlier_indices,
+    const float* __restrict__ workspace,
+    float* __restrict__ mul,
+    int width,
+    int fullwidth,
+    int headdim,
+    int num_query_heads,
+    int num_kv_groups,
+    int num_outliers,
+    int stored_tiles,
+    int workspace_tiles,
+    int64_t vec_batch_stride,
+    int64_t vec_head_stride,
+    int64_t workspace_batch_stride,
+    int64_t workspace_head_stride,
+    int64_t workspace_tile_stride
+) {
+  const int channel = threadIdx.x;
+  const int query_head = blockIdx.x;
+  const int batch = blockIdx.y;
+  float total = 0.0f;
+  const int64_t workspace_head_offset =
+      batch * workspace_batch_stride + query_head * workspace_head_stride;
+  for (int tile = 0; tile < stored_tiles; ++tile) {
+    total += workspace[
+        workspace_head_offset + tile * workspace_tile_stride + channel
+    ];
+  }
+  total += VecQuantQ23DeterministicTilePartial<BITS, LEVELS, PACKED_ROWS>(
+      vec,
+      mat,
+      lookup_table,
+      outliers,
+      outlier_indices,
+      width,
+      fullwidth,
+      headdim,
+      num_query_heads,
+      num_kv_groups,
+      num_outliers,
+      vec_batch_stride,
+      vec_head_stride,
+      batch,
+      query_head,
+      stored_tiles,
+      channel
+  );
+  mul[(batch * num_query_heads + query_head) * headdim + channel] = total;
+}
