+def _validate_exact_eager_attention(model):
+    from transformers.models.llama.modeling_llama import LlamaAttention
+
+    if getattr(model.config, "_attn_implementation", None) != "eager":
+        raise ValueError("frozen deployment must retain eager attention")
+    layers = list(model.model.layers)
+    if len(layers) != 32:
+        raise ValueError("frozen deployment must contain exactly 32 layers")
+    invalid_layers = [
+        index
+        for index, layer in enumerate(layers)
+        if type(layer.self_attn) is not LlamaAttention
+    ]
+    if invalid_layers:
+        raise ValueError(
+            "frozen deployment must use the exact patched LlamaAttention in every "
+            f"layer; invalid layers={invalid_layers}"
+        )
+    for index, layer in enumerate(layers):
+        attention = layer.self_attn
+        geometry = (
+            getattr(attention, "num_query_heads", None),
+            getattr(attention, "num_key_value_heads", None),
+            getattr(attention, "num_key_value_groups", None),
+            getattr(attention, "head_dim", None),
+        )
+        if geometry != (32, 8, 4, 128):
+            raise ValueError(
+                f"layer {index} deployment geometry must be Q32/KV8/groups4/head128, "
+                f"got {geometry}"
+            )
+        if getattr(attention, "kv_width", None) != 1024:
+            raise ValueError(f"layer {index} native KV width must be 1024")
+        if getattr(attention, "outlier_cap", None) != FIXED_OUTLIER_CAP:
+            raise ValueError(f"layer {index} attention outlier cap must be 12")
+        if getattr(attention, "first_few_fp16", None) != SINK_TOKENS:
+            raise ValueError(f"layer {index} sink token count must be 5")
+
+        kcache = getattr(attention, "kcache", None)
+        vcache = getattr(attention, "vcache", None)
+        persistent_k = getattr(kcache, "kcache", None)
+        persistent_v = getattr(vcache, "vcache", None)
+        if tuple(getattr(persistent_k, "shape", ()))[:1] != (8,):
+            raise ValueError(f"layer {index} persistent K cache must use eight KV heads")
+        if tuple(getattr(persistent_v, "shape", ()))[:1] != (8,):
+            raise ValueError(f"layer {index} persistent V cache must use eight KV heads")
+        if getattr(kcache, "outlier_cap", None) != FIXED_OUTLIER_CAP:
+            raise ValueError(f"layer {index} K cache outlier cap must be 12")
+        if getattr(vcache, "outlier_cap", None) != FIXED_OUTLIER_CAP:
+            raise ValueError(f"layer {index} V cache outlier cap must be 12")
+
+        sink_k = getattr(attention, "kcache_fp16", None)
+        sink_v = getattr(attention, "vcache_fp16", None)
+        if (
+            tuple(getattr(sink_k, "shape", ())) != (1, 8, 128, 5)
+            or getattr(sink_k, "dtype", None) != torch.float16
+        ):
+            raise ValueError(
+                f"layer {index} sink K cache must be FP16 [1,8,128,5]"
+            )
+        if (
+            tuple(getattr(sink_v, "shape", ())) != (1, 8, 5, 128)
+            or getattr(sink_v, "dtype", None) != torch.float16
+        ):
+            raise ValueError(
+                f"layer {index} sink V cache must be FP16 [1,8,5,128]"
+            )
+
