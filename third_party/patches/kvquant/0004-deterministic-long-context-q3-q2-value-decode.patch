+            "FIXED_OUTLIER_CAP = 12",
+            "first_few_fp16 != SINK_TOKENS",
+            "validate_quantizer_payload",
+            'payload["quantizers"]',
+            "VENDORED_TRANSFORMERS_ROOT",
+            "resolve_frozen_snapshot",
+            "model_artifact_manifest_sha256",
+            "_validate_exact_eager_attention(model)",
+        ):
+            self.assertIn(required, source)
+        for required in (
+            "snapshot_download_fn",
+            "snapshot_path.name != FROZEN_MODEL_REVISION",
+            "validate_snapshot_artifacts",
+            "same-process mutation must never bypass authority",
+        ):
+            self.assertIn(required, authority_source)
+        self.assertNotIn("use_flash_attention_2=True", source)
+        self.assertNotIn("model = model.half()", source)
+
+    def test_llama3_uses_cached_exact_frequency_call_convention(self) -> None:
+        source = DEPLOYMENT_SOURCE.read_text()
+        eager = source[source.index("class LlamaAttention") : source.index("class LlamaFlashAttention2")]
+        self.assertIn(
+            "self.dynamicrope = bool(config.dynamicrope and config.rope_scaling is None)",
+            eager,
+        )
+        self.assertIn('if scaling_type == "llama3":', eager)
+        self.assertIn("Llama3RotaryEmbedding(", eager)
+
+    def test_vendored_llama3_rope_matches_frozen_cross_stack_authority(self) -> None:
+        if "quant_cuda" not in sys.modules:
+            sys.modules["quant_cuda"] = ModuleType("quant_cuda")
+        from transformers.models.llama.modeling_llama import Llama3RotaryEmbedding
+
+        rotary = Llama3RotaryEmbedding(
+            dim=128,
+            max_position_embeddings=1,
+            base=500000.0,
+            rope_scaling={
+                "rope_type": "llama3",
+                "factor": 8.0,
+                "high_freq_factor": 4.0,
+                "low_freq_factor": 1.0,
+                "original_max_position_embeddings": 8192,
+            },
+            device=torch.device("cpu"),
+        )
+        reference_inv_freq = _llama3_inv_freq(torch.device("cpu"))
+        torch.testing.assert_close(
+            rotary.inv_freq,
+            reference_inv_freq,
+            rtol=0.0,
+            atol=0.0,
+        )
+
+        positions = torch.tensor(
+            [0, 1, 7, 8191, 8192, 131071], dtype=torch.float32
+        )
+        vendored_frequencies = torch.outer(positions, rotary.inv_freq)
+        reference_frequencies = torch.outer(positions, reference_inv_freq)
+        vendored_embedding = torch.cat(
+            (vendored_frequencies, vendored_frequencies), dim=-1
+        )
+        reference_embedding = torch.cat(
+            (reference_frequencies, reference_frequencies), dim=-1
+        )
+        vendored_cos = vendored_embedding.cos().contiguous()
+        vendored_sin = vendored_embedding.sin().contiguous()
+        torch.testing.assert_close(
+            vendored_cos,
+            reference_embedding.cos(),
+            rtol=0.0,
+            atol=1e-6,
+        )
+        torch.testing.assert_close(
+            vendored_sin,
+            reference_embedding.sin(),
+            rtol=0.0,
+            atol=1e-6,
+        )
+        self.assertEqual(
+            hashlib.sha256(rotary.inv_freq.contiguous().numpy().tobytes()).hexdigest(),
+            "4ae228093081627907bb1abceaa696354a9d187a0202a20492a1105c1ade70e3",
+        )
+        self.assertEqual(
+            hashlib.sha256(vendored_cos.numpy().tobytes()).hexdigest(),
+            "955429bc17554e7f3a0ea89a3459e788415df9db5f418602fb650cf9fc74f9f2",
+        )
+        self.assertEqual(
+            hashlib.sha256(vendored_sin.numpy().tobytes()).hexdigest(),
+            "867c138887830d0796800c46f7448a6c87fa14c4e868336035d72a1fca9b386b",
+        )
+
+    def test_quantizer_envelope_rejects_missing_extra_and_nonfinite_entries(self) -> None:
+        from deployment.llama import validate_quantizer_payload
+
+        payload, expected = _valid_quantizer_envelope()
+        self.assertEqual(
+            len(validate_quantizer_payload(
+                payload, bit_width=4, expected_provenance=expected
+            )),
+            64,
+        )
+
+        payload, expected = _valid_quantizer_envelope()
+        del payload["quantizers"]["model.layers.31.self_attn.v_proj"]
+        with self.assertRaisesRegex(ValueError, "exactly 32 K and 32 V"):
+            validate_quantizer_payload(
+                payload, bit_width=4, expected_provenance=expected
+            )
