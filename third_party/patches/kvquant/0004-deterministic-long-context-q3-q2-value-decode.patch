+def _llama3_inv_freq(device: torch.device) -> torch.Tensor:
+    base = 500000.0
+    dim = 128
+    factor = 8.0
+    original_context = 8192
+    low_freq_factor = 1.0
+    high_freq_factor = 4.0
+    base_inv_freq = 1.0 / (
+        base
+        ** (torch.arange(0, dim, 2, dtype=torch.float32, device=device) / dim)
+    )
+    wavelength = 2 * torch.pi / base_inv_freq
+    low_wavelength = original_context / low_freq_factor
+    high_wavelength = original_context / high_freq_factor
+    inv_freq = torch.where(
+        wavelength > low_wavelength, base_inv_freq / factor, base_inv_freq
+    )
+    smooth = (
+        original_context / wavelength - low_freq_factor
+    ) / (high_freq_factor - low_freq_factor)
+    smoothed = (1.0 - smooth) * base_inv_freq / factor + smooth * base_inv_freq
+    medium = (wavelength <= low_wavelength) & (wavelength >= high_wavelength)
+    return torch.where(medium, smoothed, inv_freq).contiguous()
+
