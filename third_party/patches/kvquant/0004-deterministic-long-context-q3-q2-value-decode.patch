+void append_value_sparse_1024_cap12_out_cuda(
+    torch::Tensor mat,
+    torch::Tensor lookup_cache,
+    torch::Tensor newvec,
+    torch::Tensor metadata_row,
+    torch::Tensor lower_bound,
+    torch::Tensor upper_bound,
+    torch::Tensor zero_point,
+    torch::Tensor selected_values,
+    torch::Tensor selected_indices,
+    torch::Tensor selected_count,
+    torch::Tensor sparse_values,
+    torch::Tensor sparse_indices,
+    torch::Tensor sparse_counts,
+    int cache_index,
+    int bits) {
+  check_cuda_contiguous(mat, "mat");
+  check_cuda_contiguous(lookup_cache, "lookup_cache");
+  check_cuda_contiguous(newvec, "newvec");
+  check_cuda_contiguous(metadata_row, "metadata_row");
+  check_cuda_contiguous(lower_bound, "lower_bound");
+  check_cuda_contiguous(upper_bound, "upper_bound");
+  check_cuda_contiguous(zero_point, "zero_point");
+  check_cuda_contiguous(selected_values, "selected_values");
+  check_cuda_contiguous(selected_indices, "selected_indices");
+  check_cuda_contiguous(selected_count, "selected_count");
+  check_cuda_contiguous(sparse_values, "sparse_values");
+  check_cuda_contiguous(sparse_indices, "sparse_indices");
+  check_cuda_contiguous(sparse_counts, "sparse_counts");
+  TORCH_CHECK(bits == 2 || bits == 3 || bits == 4, "bits must be 2, 3, or 4");
+  const int levels = 1 << bits;
+  const int packed_rows = bits * kHeadDim / 32;
+  TORCH_CHECK(mat.scalar_type() == torch::kInt32, "mat must be int32");
+  TORCH_CHECK(
+      lookup_cache.scalar_type() == torch::kFloat32 &&
+      newvec.scalar_type() == torch::kFloat32 &&
+      metadata_row.scalar_type() == torch::kFloat32 &&
+      lower_bound.scalar_type() == torch::kFloat32 &&
+      upper_bound.scalar_type() == torch::kFloat32 &&
+      zero_point.scalar_type() == torch::kFloat32 &&
+      selected_values.scalar_type() == torch::kFloat32 &&
+      sparse_values.scalar_type() == torch::kFloat32,
+      "Value data/metadata tensors must be float32");
+  TORCH_CHECK(
+      selected_indices.scalar_type() == torch::kInt32 &&
+      selected_count.scalar_type() == torch::kInt32 &&
+      sparse_indices.scalar_type() == torch::kInt32 &&
+      sparse_counts.scalar_type() == torch::kInt32,
+      "Value indices and counts must be int32");
+  TORCH_CHECK(
+      mat.dim() == 3 &&
+      mat.size(0) == kNumKvHeads &&
+      mat.size(1) == packed_rows,
+      "mat must use native [8, packed_rows, capacity] geometry");
+  const int fullwidth = mat.size(2);
+  TORCH_CHECK(
+      lookup_cache.dim() == 2 &&
+      lookup_cache.size(0) == fullwidth &&
+      lookup_cache.size(1) == levels,
+      "lookup_cache shape mismatch");
+  TORCH_CHECK(newvec.numel() == kMeasurementWidth, "newvec must have 1024 values");
+  TORCH_CHECK(metadata_row.numel() == levels, "metadata_row size mismatch");
+  TORCH_CHECK(
+      lower_bound.numel() == 1 &&
+      upper_bound.numel() == 1 &&
+      zero_point.numel() == 1,
+      "Value extrema and zero-point must be one-element CUDA tensors");
+  TORCH_CHECK(
+      selected_values.numel() == kSparseCapacity &&
+      selected_indices.numel() == kSparseCapacity &&
+      selected_count.numel() == 1,
+      "selected Value state must have capacity 12 and one count");
+  TORCH_CHECK(
+      sparse_values.sizes() ==
+          torch::IntArrayRef({fullwidth, kSparseCapacity}) &&
+      sparse_indices.sizes() == sparse_values.sizes() &&
+      sparse_counts.numel() == fullwidth,
+      "Value sparse output cache shape mismatch");
+  TORCH_CHECK(
+      cache_index >= 0 && cache_index < fullwidth,
+      "cache_index is out of bounds");
+  for (const auto* item : {
+           &lookup_cache,
+           &newvec,
+           &metadata_row,
+           &lower_bound,
+           &upper_bound,
+           &zero_point,
+           &selected_values,
+           &selected_indices,
+           &selected_count,
+           &sparse_values,
+           &sparse_indices,
+           &sparse_counts}) {
+    check_same_device(mat, *item, "Value append tensor");
+  }
+
+  constexpr int threads = 128;
+  ClearValuePackedColumnKernel<<<
+      (kNumKvHeads * packed_rows + threads - 1) / threads,
+      threads,
+      0,
+      at::cuda::getCurrentCUDAStream()>>>(
+      mat.data_ptr<int>(), packed_rows, fullwidth, cache_index);
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+  WriteValueMetadataAndSparseKernel<<<
+      1,
+      threads,
+      0,
+      at::cuda::getCurrentCUDAStream()>>>(
+      lookup_cache.data_ptr<float>(),
+      metadata_row.data_ptr<float>(),
+      zero_point.data_ptr<float>(),
+      selected_values.data_ptr<float>(),
+      selected_indices.data_ptr<int>(),
+      selected_count.data_ptr<int>(),
+      sparse_values.data_ptr<float>(),
+      sparse_indices.data_ptr<int>(),
+      sparse_counts.data_ptr<int>(),
+      levels,
+      cache_index);
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+  AppendValueSparseDeviceOutKernel<<<
+      (kMeasurementWidth + threads - 1) / threads,
+      threads,
+      0,
+      at::cuda::getCurrentCUDAStream()>>>(
+      mat.data_ptr<int>(),
+      metadata_row.data_ptr<float>(),
+      newvec.data_ptr<float>(),
+      lower_bound.data_ptr<float>(),
+      upper_bound.data_ptr<float>(),
+      bits,
+      levels,
+      packed_rows,
+      fullwidth,
+      cache_index);
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
