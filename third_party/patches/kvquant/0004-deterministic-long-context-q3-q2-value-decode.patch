+def _is_lower_hex(value, length):
+    return (
+        isinstance(value, str)
+        and len(value) == length
+        and all(character in "0123456789abcdef" for character in value)
+    )
+
+
+def _source_float32_tensor(value, *, name, expected_shape):
+    if not isinstance(value, torch.Tensor):
+        raise ValueError(f"{name} must be a source-native torch.Tensor")
+    if value.device.type != "cpu" or value.dtype != torch.float32:
+        raise ValueError(f"{name} must be a CPU float32 tensor")
+    if tuple(value.shape) != expected_shape or not torch.isfinite(value).all().item():
+        raise ValueError(f"{name} has an invalid shape or non-finite value")
+    return value
+
+
+def _validate_quantizer_map_schema(quantizers, provenance, bit_width):
+    expected_names = {
+        f"model.layers.{layer}.self_attn.{role}_proj"
+        for layer in range(32)
+        for role in ("k", "v")
+    }
+    if set(quantizers) != expected_names:
+        raise ValueError("quantizer map must contain exactly 32 K and 32 V layer entries")
+    levels = 1 << bit_width
+    value_rows = provenance["num_examples"] * provenance["sequence_length"]
+    for name in sorted(expected_names):
+        quantizer = quantizers[name]
+        if not isinstance(quantizer, tuple) or len(quantizer) != 3:
+            raise ValueError(f"{name} must use the source-native three-item NUQ tuple")
+        is_key = name.endswith("k_proj")
+        threshold_shape = (1, 1024) if is_key else (value_rows, 1)
+        upper = _source_float32_tensor(
+            quantizer[0], name=f"{name}.upper", expected_shape=threshold_shape
+        )
+        lower = _source_float32_tensor(
+            quantizer[1], name=f"{name}.lower", expected_shape=threshold_shape
+        )
+        if not torch.all(upper >= lower).item():
+            raise ValueError(f"{name} has inverted sparse thresholds")
+        centroids = quantizer[2]
+        if not isinstance(centroids, list) or len(centroids) != 1:
+            raise ValueError(f"{name} must contain one source-native NUQ codebook")
+        try:
+            centroid = torch.as_tensor(centroids[0])
+        except (TypeError, ValueError) as error:
+            raise ValueError(f"{name} codebook is not tensor-compatible") from error
+        if (
+            centroid.device.type != "cpu"
+            or centroid.dtype != torch.float32
+            or tuple(centroid.shape) != (levels, 1)
+            or not torch.isfinite(centroid).all().item()
+        ):
+            raise ValueError(f"{name} codebook has an invalid shape, dtype, or value")
+
+
+def validate_quantizer_payload(payload, *, bit_width, expected_provenance):
+    if not isinstance(payload, dict) or set(payload) != {
+        "format", "provenance", "quantizers"
+    }:
+        raise ValueError("quantizer artifact must be the exact v1 provenance envelope")
+    if payload["format"] != "kvquant_gqa_quantizer_v1":
+        raise ValueError("unsupported quantizer envelope format")
+    provenance = payload["provenance"]
+    quantizers = payload["quantizers"]
+    if not isinstance(provenance, dict) or not isinstance(quantizers, dict) or not quantizers:
+        raise ValueError("quantizer provenance and non-empty quantizer map are required")
+    if provenance.get("num_examples") != 16:
+        raise ValueError("deployment quantizers require exactly 16 calibration examples")
+    if provenance.get("sequence_length") != 2048:
+        raise ValueError("deployment quantizers require calibration sequence_length=2048")
+
+    fixed = {
+        "method_identifier": METHOD_IDENTIFIER,
+        "model_id": FROZEN_MODEL_ID,
+        "model_revision": FROZEN_MODEL_REVISION,
+        "tokenizer_id": FROZEN_TOKENIZER_ID,
+        "tokenizer_revision": FROZEN_TOKENIZER_REVISION,
+        "upstream_base_commit": UPSTREAM_BASE_COMMIT,
+        "upstream_base_tree": UPSTREAM_BASE_TREE,
+        "bit_width": bit_width,
+        "model_forward_dtype": "bfloat16",
+        "fisher_dtype": "float32",
+        "fitting_dtype": "float16",
+        "nuq": True,
+        "dense_and_sparse": True,
+        "sparsity_threshold": 0.99,
+        "key_outlier_cap": FIXED_OUTLIER_CAP,
+        "value_outlier_cap": FIXED_OUTLIER_CAP,
+        "sink_tokens": SINK_TOKENS,
+    }
+    complete_expected = dict(fixed)
+    complete_expected.update(expected_provenance)
+    if set(provenance) != set(complete_expected):
+        raise ValueError("quantizer provenance field set is incomplete or unexpected")
+    for name, expected in complete_expected.items():
+        if provenance[name] != expected:
+            raise ValueError(
+                f"quantizer provenance {name!r} mismatch: expected {expected!r}, "
+                f"got {provenance[name]!r}"
+            )
+    for name in ("patched_commit", "patched_tree"):
+        if not _is_lower_hex(provenance[name], 40):
+            raise ValueError(f"quantizer provenance {name} is not a Git identity")
+    for name in (
+        "patch_digest", "fisher_root", "dataset_root", "token_tensor_sha256"
+    ):
+        if not _is_lower_hex(provenance[name], 64):
+            raise ValueError(f"quantizer provenance {name} is not a SHA-256 identity")
+    _validate_quantizer_map_schema(quantizers, provenance, bit_width)
+    return quantizers
+
