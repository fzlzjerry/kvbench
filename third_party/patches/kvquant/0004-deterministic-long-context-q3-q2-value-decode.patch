+def run_graph(quant_cuda, root: Path) -> None:
+    operation, tensors, expected_summary = graph_inputs(quant_cuda, root)
+    side = torch.cuda.Stream()
+    side.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(side):
+        for _ in range(3):
+            operation()
+    torch.cuda.current_stream().wait_stream(side)
+    torch.cuda.synchronize()
+    eager_output = tensors[-1].clone()
+    pointer_values = tuple(item.data_ptr() for item in tensors)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        operation()
+    graph.replay()
+    torch.cuda.synchronize()
+    graph_output = tensors[-1].clone()
+    torch.testing.assert_close(graph_output, eager_output, atol=0.0, rtol=0.0)
+    before_allocated = torch.cuda.memory_allocated()
+    before_reserved = torch.cuda.memory_reserved()
+    for _ in range(5):
+        graph.replay()
+    torch.cuda.synchronize()
+    if torch.cuda.memory_allocated() != before_allocated:
+        raise AssertionError("CUDA Graph replay changed allocated bytes")
+    if torch.cuda.memory_reserved() != before_reserved:
+        raise AssertionError("CUDA Graph replay changed reserved bytes")
+    if pointer_values != tuple(item.data_ptr() for item in tensors):
+        raise AssertionError("CUDA Graph replay changed caller-owned pointers")
+    observed_summary = torch.stack(
+        (
+            torch.sum(tensors[7][STORE_QUANTIZED]),
+            torch.sum(tensors[8][STORE_QUANTIZED].float()),
+        )
+    )
+    torch.testing.assert_close(observed_summary, expected_summary, atol=0.0, rtol=0.0)
+    print("PASS graph selector->append->decode zero-replay-allocation", flush=True)
+    graph.reset()
+    del (
+        graph,
+        operation,
+        tensors,
+        expected_summary,
+        eager_output,
+        graph_output,
+        observed_summary,
+        side,
+    )
+    gc.collect()
