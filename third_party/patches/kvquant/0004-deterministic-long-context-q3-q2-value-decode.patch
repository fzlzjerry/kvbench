+class Llama3RotaryEmbedding(LlamaRotaryEmbedding):
+    """Exact Llama-3.1 frequency scaling; this is not generic linear RoPE."""
+
+    def __init__(self, dim, max_position_embeddings, base, rope_scaling, device=None):
+        self.rope_scaling = dict(rope_scaling)
+        super().__init__(dim, max_position_embeddings, base, device)
+
+    def _set_cos_sin_cache(self, seq_len, device, dtype):
+        factor = float(self.rope_scaling["factor"])
+        low_freq_factor = float(self.rope_scaling["low_freq_factor"])
+        high_freq_factor = float(self.rope_scaling["high_freq_factor"])
+        original_context = int(
+            self.rope_scaling["original_max_position_embeddings"]
+        )
+        base_inv_freq = 1.0 / (
+            self.base
+            ** (
+                torch.arange(0, self.dim, 2, dtype=torch.float32, device=device)
+                / self.dim
+            )
+        )
+        wavelength = 2 * math.pi / base_inv_freq
+        low_wavelength = original_context / low_freq_factor
+        high_wavelength = original_context / high_freq_factor
+        inv_freq = torch.where(
+            wavelength > low_wavelength, base_inv_freq / factor, base_inv_freq
+        )
+        smooth = (
+            original_context / wavelength - low_freq_factor
+        ) / (high_freq_factor - low_freq_factor)
+        smoothed = (1.0 - smooth) * base_inv_freq / factor + smooth * base_inv_freq
+        medium = (wavelength <= low_wavelength) & (wavelength >= high_wavelength)
+        inv_freq = torch.where(medium, smoothed, inv_freq)
+        self.register_buffer("inv_freq", inv_freq, persistent=False)
+
+        self.max_seq_len_cached = seq_len
+        positions = torch.arange(seq_len, device=device, dtype=torch.float32)
+        frequencies = torch.outer(positions, self.inv_freq)
+        embedding = torch.cat((frequencies, frequencies), dim=-1)
+        self.register_buffer("cos_cached", embedding.cos().to(dtype), persistent=False)
+        self.register_buffer("sin_cached", embedding.sin().to(dtype), persistent=False)
+
