index 0000000000000000000000000000000000000000..d43e09240b63f2c0bedda334114a2f96f6b9ef28
--- /dev/null
+++ b/kvquant_gqa/compat.py
@@ -0,0 +1,1061 @@
+"""Narrow Llama-3.1 GQA compatibility policy for the pinned KVQuant source.
+
+This module intentionally supports one model authority.  It does not provide a
+generic model-patching or calibration framework.
+"""
+
+from __future__ import annotations
+
+import math
+import random
+import hashlib
+import json
+from dataclasses import dataclass
+from pathlib import Path, PurePosixPath
+from typing import Any, Iterable
+
+import torch
+
+FROZEN_MODEL_ID = "meta-llama/Llama-3.1-8B-Instruct"
+FROZEN_MODEL_REVISION = "0e9e39f249a16976918f6564b8830bc894c89659"
+FROZEN_TOKENIZER_ID = FROZEN_MODEL_ID
+FROZEN_TOKENIZER_REVISION = FROZEN_MODEL_REVISION
+UPSTREAM_BASE_COMMIT = "57a238357f0ffe50084670fcd5781c9848f80ea2"
+UPSTREAM_BASE_TREE = "094e0f736f77ee327e5350cbd1eefb1c936aa77b"
+METHOD_IDENTIFIER = "kvquant_gqa_upstream_patch_v1"
+
+FORWARD_DTYPE = torch.bfloat16
+FISHER_DTYPE = torch.float32
+FITTING_DTYPE = torch.float16
+SINK_TOKENS = 5
+MODEL_SNAPSHOT_MANIFEST_FORMAT = "kvquant_gqa_model_snapshot_v1"
+REQUIRED_SNAPSHOT_FILES = {
+    "config.json",
+    "generation_config.json",
+    "model.safetensors.index.json",
+    "special_tokens_map.json",
+    "tokenizer.json",
+    "tokenizer_config.json",
+}
+
+EXPECTED_ROPE_SCALING = {
+    "rope_type": "llama3",
+    "factor": 8.0,
+    "high_freq_factor": 4.0,
+    "low_freq_factor": 1.0,
+    "original_max_position_embeddings": 8192,
+}
+
+
+@dataclass(frozen=True)
+class GQAGeometry:
+    num_query_heads: int
+    num_kv_heads: int
+    num_kv_groups: int
+    head_dim: int
+    hidden_size: int
+    kv_width: int
+
+
+@dataclass(frozen=True)
+class FixedSparseSelection:
+    """Fixed-cap sparse rows, with lower-tail entries before upper-tail entries."""
+
+    values: torch.Tensor
+    indices: torch.Tensor
+    counts: torch.Tensor
+    dense_lower_bound: torch.Tensor
+    dense_upper_bound: torch.Tensor
+
+
+@dataclass(frozen=True)
+class FrozenParameterIdentity:
+    object_id: int
+    data_ptr: int
+    version: int
+    shape: tuple[int, ...]
+    dtype: torch.dtype
+    sample_digest: str
+
+
+def _parameter_sample_digest(parameter: torch.nn.Parameter) -> str:
+    flat = parameter.detach().reshape(-1)
+    if flat.numel() == 0:
+        return hashlib.sha256(b"").hexdigest()
+    indices = sorted({0, flat.numel() // 2, flat.numel() - 1})
+    samples = torch.stack([flat[index] for index in indices]).contiguous().cpu()
+    return hashlib.sha256(samples.view(torch.uint8).numpy().tobytes()).hexdigest()
+
+
+def freeze_and_snapshot_model_weights(
+    model: torch.nn.Module,
+) -> dict[str, FrozenParameterIdentity]:
+    """Freeze and bind every model parameter plus a bitwise sample of each."""
+
+    snapshot: dict[str, FrozenParameterIdentity] = {}
+    for name, parameter in model.named_parameters():
+        parameter.requires_grad_(False)
+        snapshot[name] = FrozenParameterIdentity(
+            object_id=id(parameter),
+            data_ptr=parameter.data_ptr(),
+            version=parameter._version,
+            shape=tuple(parameter.shape),
+            dtype=parameter.dtype,
+            sample_digest=_parameter_sample_digest(parameter),
+        )
+    if not snapshot:
+        raise ValueError("frozen model must contain parameters")
+    return snapshot
+
+
+def assert_model_weights_unchanged(
+    model: torch.nn.Module,
+    snapshot: dict[str, FrozenParameterIdentity],
+) -> None:
+    current = dict(model.named_parameters())
+    if set(current) != set(snapshot):
+        raise RuntimeError("model parameter names changed during Fisher collection")
+    for name, expected in snapshot.items():
+        parameter = current[name]
+        actual = FrozenParameterIdentity(
+            object_id=id(parameter),
+            data_ptr=parameter.data_ptr(),
+            version=parameter._version,
+            shape=tuple(parameter.shape),
+            dtype=parameter.dtype,
+            sample_digest=_parameter_sample_digest(parameter),
+        )
+        if parameter.requires_grad or parameter.grad is not None:
+            raise RuntimeError(f"model parameter {name!r} accumulated a gradient")
+        if actual != expected:
+            raise RuntimeError(f"model parameter {name!r} changed during Fisher collection")
+
+
+def validate_source_identity(
+    model_id: str,
+    revision: str,
+    tokenizer_id: str,
+    tokenizer_revision: str,
+) -> None:
+    expected = (
+        FROZEN_MODEL_ID,
+        FROZEN_MODEL_REVISION,
+        FROZEN_TOKENIZER_ID,
+        FROZEN_TOKENIZER_REVISION,
+    )
+    actual = (model_id, revision, tokenizer_id, tokenizer_revision)
+    if actual != expected:
+        raise ValueError(
+            "KVQuant-GQA patch is bound to the frozen Llama-3.1 model and "
+            f"tokenizer identity; expected {expected!r}, got {actual!r}"
+        )
+
+
+def validate_quantizer_generation_policy(
+    *,
+    perchannel: Any,
+    pertoken: Any,
+    norm: bool,
+    nf: bool,
+    clamp: bool,
+    num_examples: int,
+    sequence_length: int,
+    max_sequence_length: int,
+) -> None:
+    """Reject CLI modes outside the single frozen Phase 9 quantizer contract."""
+
+    if perchannel != ["k_proj"]:
+        raise ValueError("per-channel quantization must target only pre-RoPE k_proj")
+    if pertoken != ["v_proj"]:
+        raise ValueError("per-token quantization must target only native-GQA v_proj")
+    if norm or nf or clamp:
+        raise ValueError("q-norm, NormalFloat, and integer clamp modes are forbidden")
+    if num_examples != 16:
+        raise ValueError("full quantizer generation requires exactly 16 examples")
+    if sequence_length != 2048 or max_sequence_length != 2048:
+        raise ValueError(
+            "full quantizer generation requires seqlen=maxseqlen=2048"
+        )
+
+
+def validate_fisher_calibration_policy(
+    *,
+    dataset: str,
+    num_examples: int,
+    sequence_length: int,
+    max_sequence_length: int,
+    model_max_length: int,
+) -> None:
+    """Reject Fisher execution outside the sole frozen Phase 9 contract."""
+
+    if dataset != "wikitext2":
+        raise ValueError("Fisher calibration is restricted to WikiText-2 train")
+    if num_examples != 16:
+        raise ValueError("Fisher calibration requires exactly 16 examples")
+    if sequence_length != 2048 or max_sequence_length != 2048:
+        raise ValueError("Fisher calibration requires seqlen=maxseqlen=2048")
+    if model_max_length != 2048:
+        raise ValueError("Fisher tokenizer model_max_length must equal 2048")
+
+
+def _config_dtype_name(config: Any) -> str:
+    dtype = getattr(config, "torch_dtype", None)
+    if isinstance(dtype, torch.dtype):
+        return str(dtype).removeprefix("torch.")
+    return str(dtype)
+
+
+def validate_frozen_config(config: Any) -> GQAGeometry:
+    if getattr(config, "model_type", None) != "llama":
+        raise ValueError("frozen KVQuant-GQA authority requires model_type=llama")
+    if getattr(config, "num_hidden_layers", None) != 32:
+        raise ValueError("frozen KVQuant-GQA authority requires 32 layers")
+    if getattr(config, "max_position_embeddings", None) != 131072:
+        raise ValueError("frozen KVQuant-GQA authority requires max context 131072")
+    if float(getattr(config, "rope_theta", -1)) != 500000.0:
+        raise ValueError("frozen KVQuant-GQA authority requires rope_theta=500000")
+    if _config_dtype_name(config) != "bfloat16":
+        raise ValueError("frozen KVQuant-GQA model config must declare bfloat16")
+
+    rope_scaling = getattr(config, "rope_scaling", None)
+    if not isinstance(rope_scaling, dict):
+        raise ValueError("frozen KVQuant-GQA authority requires llama3 rope_scaling")
+    if rope_scaling.get("type") == "linear" or rope_scaling.get("rope_type") == "linear":
+        raise ValueError("legacy linear RoPE substitution is forbidden")
+    for name, expected in EXPECTED_ROPE_SCALING.items():
+        actual = rope_scaling.get(name)
+        if actual != expected:
+            raise ValueError(
+                f"frozen llama3 RoPE field {name!r} must be {expected!r}, got {actual!r}"
+            )
+
+    geometry = derive_geometry(config)
+    expected_geometry = GQAGeometry(
+        num_query_heads=32,
+        num_kv_heads=8,
+        num_kv_groups=4,
+        head_dim=128,
+        hidden_size=4096,
+        kv_width=1024,
+    )
+    if geometry != expected_geometry:
+        raise ValueError(
+            "frozen Llama-3.1 GQA geometry mismatch: "
+            f"expected {expected_geometry!r}, got {geometry!r}"
+        )
+    return geometry
+
+
+def derive_geometry(config: Any) -> GQAGeometry:
+    hidden_size = int(config.hidden_size)
+    num_query_heads = int(config.num_attention_heads)
+    num_kv_heads = int(config.num_key_value_heads)
+    if num_query_heads <= 0 or num_kv_heads <= 0:
+        raise ValueError("query-head and KV-head counts must be positive")
+    if hidden_size % num_query_heads != 0:
+        raise ValueError("hidden_size must be divisible by num_query_heads")
+    if num_query_heads % num_kv_heads != 0:
+        raise ValueError("num_query_heads must be divisible by num_kv_heads")
+    head_dim = hidden_size // num_query_heads
+    num_kv_groups = num_query_heads // num_kv_heads
+    return GQAGeometry(
+        num_query_heads=num_query_heads,
+        num_kv_heads=num_kv_heads,
+        num_kv_groups=num_kv_groups,
+        head_dim=head_dim,
+        hidden_size=hidden_size,
+        kv_width=num_kv_heads * head_dim,
+    )
+
+
+def _is_lower_hex_identity(value: Any, length: int) -> bool:
+    return (
+        isinstance(value, str)
+        and len(value) == length
+        and all(character in "0123456789abcdef" for character in value)
+    )
+
+
+def _reject_forbidden_authority_path(path: str | Path, label: str) -> None:
+    if any(
+        part == ".env" or part.startswith(".env.")
+        for part in Path(path).parts
+    ):
+        raise ValueError(
+            f"refusing to read {label} from an environment-secret path"
+        )
+
+
+def _normalize_snapshot_manifest_files(files: Any) -> dict[str, str]:
+    if not isinstance(files, dict) or not files:
+        raise ValueError("model snapshot manifest must contain a non-empty files map")
+    normalized: dict[str, str] = {}
+    for relative_name, digest in files.items():
+        if not isinstance(relative_name, str) or "\\" in relative_name:
+            raise ValueError("model snapshot manifest paths must be POSIX strings")
+        relative_path = PurePosixPath(relative_name)
+        if (
+            relative_path.is_absolute()
+            or not relative_path.parts
+            or any(part in ("", ".", "..") for part in relative_path.parts)
+        ):
+            raise ValueError(f"invalid model snapshot manifest path {relative_name!r}")
+        _reject_forbidden_authority_path(
+            relative_path.as_posix(), "model snapshot artifact"
+        )
+        if not _is_lower_hex_identity(digest, 64):
+            raise ValueError(
+                f"model snapshot artifact {relative_name!r} must have a SHA-256 digest"
+            )
+        normalized[relative_path.as_posix()] = digest
+    if not REQUIRED_SNAPSHOT_FILES.issubset(normalized):
+        missing = sorted(REQUIRED_SNAPSHOT_FILES - set(normalized))
+        raise ValueError(f"model snapshot manifest is missing required files: {missing}")
+    if not any(
+        name.startswith("model-") and name.endswith(".safetensors")
+        for name in normalized
+    ):
+        raise ValueError("model snapshot manifest must bind the sharded model weights")
+    return normalized
+
+
+def _reject_duplicate_json_pairs(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
+    result: dict[str, Any] = {}
+    for name, value in pairs:
+        if name in result:
+            raise ValueError(f"model artifact manifest duplicates field {name!r}")
+        result[name] = value
+    return result
+
+
+def validate_snapshot_artifacts(
+    snapshot_path: str | Path,
+    model_artifact_manifest: str | Path,
+    model_artifact_manifest_sha256: str,
+) -> Path:
+    snapshot_path = Path(snapshot_path).resolve(strict=True)
+    manifest_path = Path(model_artifact_manifest)
+    _reject_forbidden_authority_path(manifest_path, "model artifact manifest")
+    resolved_manifest_path = manifest_path.resolve(strict=True)
+    _reject_forbidden_authority_path(
+        resolved_manifest_path, "model artifact manifest"
+    )
+    if not _is_lower_hex_identity(model_artifact_manifest_sha256, 64):
+        raise ValueError("model artifact manifest identity must be a SHA-256 digest")
+    if file_sha256(resolved_manifest_path) != model_artifact_manifest_sha256:
+        raise ValueError("model artifact manifest checksum does not match its authority")
+    try:
+        payload = json.loads(
+            resolved_manifest_path.read_text(encoding="utf-8"),
+            object_pairs_hook=_reject_duplicate_json_pairs,
+        )
+    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
+        raise ValueError("model artifact manifest must be valid UTF-8 JSON") from error
+    if not isinstance(payload, dict) or set(payload) != {
+        "format", "model_id", "revision", "files"
+    }:
+        raise ValueError("model artifact manifest has an unexpected field set")
+    if payload["format"] != MODEL_SNAPSHOT_MANIFEST_FORMAT:
+        raise ValueError("model artifact manifest format is unsupported")
+    if payload["model_id"] != FROZEN_MODEL_ID:
+        raise ValueError("model artifact manifest model identity is not frozen")
+    if payload["revision"] != FROZEN_MODEL_REVISION:
+        raise ValueError("model artifact manifest revision is not frozen")
+    expected_files = _normalize_snapshot_manifest_files(payload["files"])
+
+    actual_files: dict[str, Path] = {}
+    for candidate in snapshot_path.rglob("*"):
+        if candidate.is_symlink() and not candidate.is_file():
+            raise ValueError(f"model snapshot contains a broken file link: {candidate}")
+        if not candidate.is_file():
+            continue
+        relative_name = candidate.relative_to(snapshot_path).as_posix()
+        _reject_forbidden_authority_path(
+            relative_name, "model snapshot artifact"
+        )
+        resolved_file = candidate.resolve(strict=True)
+        _reject_forbidden_authority_path(
+            resolved_file, "model snapshot artifact"
+        )
+        actual_files[relative_name] = resolved_file
+    if set(actual_files) != set(expected_files):
+        missing = sorted(set(expected_files) - set(actual_files))
+        unexpected = sorted(set(actual_files) - set(expected_files))
+        raise ValueError(
+            "model snapshot file inventory mismatch: "
+            f"missing={missing}, unexpected={unexpected}"
+        )
+
+    # Re-hash on every invocation: same-process mutation must never bypass authority.
+    for relative_name in sorted(expected_files):
+        if file_sha256(actual_files[relative_name]) != expected_files[relative_name]:
+            raise ValueError(
+                f"model snapshot artifact checksum mismatch: {relative_name}"
+            )
+    return snapshot_path
+
+
+def resolve_frozen_snapshot(
+    model_artifact_manifest: str | Path,
+    model_artifact_manifest_sha256: str,
+    *,
+    cache_dir: str | None = None,
+    snapshot_download_fn: Any = None,
+) -> Path:
+    if snapshot_download_fn is None:
+        from huggingface_hub import snapshot_download
+
+        snapshot_download_fn = snapshot_download
+    download_arguments = {
+        "repo_id": FROZEN_MODEL_ID,
+        "revision": FROZEN_MODEL_REVISION,
+        "local_files_only": True,
+    }
+    if cache_dir is not None:
+        download_arguments["cache_dir"] = cache_dir
+    downloaded_path = snapshot_download_fn(**download_arguments)
+    snapshot_path = Path(downloaded_path).resolve(strict=True)
+    if snapshot_path.name != FROZEN_MODEL_REVISION:
+        raise ValueError(
+            "offline model snapshot path must resolve to the exact frozen revision"
+        )
+    return validate_snapshot_artifacts(
+        snapshot_path,
+        model_artifact_manifest,
+        model_artifact_manifest_sha256,
+    )
+
+
+def verify_object_commit_if_present(
+    authority: Any, expected_revision: str, label: str
+) -> None:
+    actual_revision = getattr(authority, "_commit_hash", None)
+    if actual_revision is None and hasattr(authority, "init_kwargs"):
+        actual_revision = authority.init_kwargs.get("_commit_hash")
+    if actual_revision is not None and actual_revision != expected_revision:
+        raise ValueError(
+            f"{label} cache identity must resolve to {expected_revision}, "
+            f"got {actual_revision!r}"
+        )
+
+
+def _load_config_from_verified_snapshot(snapshot_path: Path) -> Any:
+    from transformers import AutoConfig
+
+    config = AutoConfig.from_pretrained(
+        str(snapshot_path),
+        local_files_only=True,
+        trust_remote_code=False,
+    )
+    verify_object_commit_if_present(config, FROZEN_MODEL_REVISION, "model config")
+    validate_frozen_config(config)
+    config._attn_implementation = "eager"
+    return config
+
+
+def load_frozen_config(
+    *,
+    model_artifact_manifest: str | Path,
+    model_artifact_manifest_sha256: str,
+    cache_dir: str | None = None,
+    snapshot_download_fn: Any = None,
+) -> Any:
+    snapshot_path = resolve_frozen_snapshot(
+        model_artifact_manifest,
+        model_artifact_manifest_sha256,
+        cache_dir=cache_dir,
+        snapshot_download_fn=snapshot_download_fn,
+    )
+    return _load_config_from_verified_snapshot(snapshot_path)
+
+
+def load_frozen_tokenizer(
+    *,
+    model_artifact_manifest: str | Path,
+    model_artifact_manifest_sha256: str,
+    cache_dir: str | None = None,
+    snapshot_download_fn: Any = None,
+) -> Any:
+    from transformers import AutoTokenizer
+
+    snapshot_path = resolve_frozen_snapshot(
+        model_artifact_manifest,
+        model_artifact_manifest_sha256,
+        cache_dir=cache_dir,
+        snapshot_download_fn=snapshot_download_fn,
+    )
+    tokenizer = AutoTokenizer.from_pretrained(
+        str(snapshot_path),
+        local_files_only=True,
+        trust_remote_code=False,
+        use_fast=True,
+    )
+    verify_object_commit_if_present(
+        tokenizer, FROZEN_TOKENIZER_REVISION, "tokenizer"
+    )
+    return tokenizer
+
+
+def load_frozen_model(
+    *,
+    model_artifact_manifest: str | Path,
+    model_artifact_manifest_sha256: str,
+    cache_dir: str | None = None,
+    device_map: str | dict[str, Any] | None = None,
+    snapshot_download_fn: Any = None,
+) -> Any:
+    from transformers import AutoModelForCausalLM
+
+    snapshot_path = resolve_frozen_snapshot(
+        model_artifact_manifest,
+        model_artifact_manifest_sha256,
+        cache_dir=cache_dir,
+        snapshot_download_fn=snapshot_download_fn,
+    )
+    config = _load_config_from_verified_snapshot(snapshot_path)
+    model = AutoModelForCausalLM.from_pretrained(
+        str(snapshot_path),
+        config=config,
+        local_files_only=True,
+        trust_remote_code=False,
+        dtype=FORWARD_DTYPE,
+        attn_implementation="eager",
+        device_map=device_map,
+    )
+    if getattr(model.config, "_attn_implementation", None) != "eager":
+        raise ValueError("frozen calibration model must retain eager attention")
+    from transformers.models.llama.modeling_llama import LlamaAttention
+
+    layers = list(model.model.layers)
+    if len(layers) != 32 or any(
+        type(layer.self_attn) is not LlamaAttention for layer in layers
+    ):
+        raise ValueError(
+            "frozen calibration model must use exact eager LlamaAttention in all 32 layers"
+        )
+    floating_dtypes = {
+        parameter.dtype for parameter in model.parameters() if parameter.is_floating_point()
+    }
+    if floating_dtypes != {FORWARD_DTYPE}:
+        raise ValueError(
+            f"frozen model weights must all be BF16, got {sorted(map(str, floating_dtypes))}"
+        )
+    model.eval()
+    return model
+
+
+def reshape_projection(
+    output: torch.Tensor,
+    role: str,
+    geometry: GQAGeometry,
+) -> torch.Tensor:
+    if output.ndim != 3:
+        raise ValueError(f"{role} projection must have [batch, sequence, width] shape")
+    if role == "query":
+        heads = geometry.num_query_heads
+        expected_width = geometry.hidden_size
+    elif role in {"key_pre_rope", "value"}:
+        heads = geometry.num_kv_heads
+        expected_width = geometry.kv_width
+    else:
+        raise ValueError(f"unsupported projection role {role!r}")
+    if output.shape[-1] != expected_width:
+        raise ValueError(
+            f"{role} projection width must be {expected_width}, got {output.shape[-1]}"
+        )
+    return output.reshape(output.shape[0], output.shape[1], heads, geometry.head_dim)
+
+
+class NativeKVHookCapture:
+    """Capture native query, pre-RoPE K, and native-H_KV V projections."""
+
+    def __init__(
+        self,
+        layers: Iterable[torch.nn.Module],
+        geometry: GQAGeometry,
+        *,
+        require_layer_count: int | None = 32,
+    ) -> None:
+        self.layers = list(layers)
+        if require_layer_count is not None and len(self.layers) != require_layer_count:
+            raise ValueError(
+                f"expected {require_layer_count} transformer layers, got {len(self.layers)}"
+            )
+        self.geometry = geometry
+        self.raw: dict[tuple[int, str], torch.Tensor] = {}
+        self.native: dict[tuple[int, str], torch.Tensor] = {}
+        self._handles: list[Any] = []
+
+    def _capture(self, layer_index: int, role: str):
+        def hook(
+            _module: torch.nn.Module,
+            _inputs: tuple[torch.Tensor, ...],
+            output: torch.Tensor,
+        ) -> None:
+            native = reshape_projection(output, role, self.geometry)
+            if role != "query" and not output.requires_grad:
+                raise RuntimeError(
+                    "K/V projection outputs must be connected to the input-activation "
+                    "gradient graph"
+                )
+            if role != "query":
+                output.retain_grad()
+            key = (layer_index, role)
+            self.raw[key] = output
+            self.native[key] = native
+
+        return hook
+
+    def install(self) -> "NativeKVHookCapture":
+        if self._handles:
+            raise RuntimeError("native KV capture hooks are already installed")
+        for index, layer in enumerate(self.layers):
+            attention = layer.self_attn
+            self._handles.append(
+                attention.q_proj.register_forward_hook(self._capture(index, "query"))
+            )
+            self._handles.append(
+                attention.k_proj.register_forward_hook(
+                    self._capture(index, "key_pre_rope")
+                )
+            )
+            self._handles.append(
+                attention.v_proj.register_forward_hook(self._capture(index, "value"))
+            )
+        return self
+
+    def clear_batch(self) -> None:
+        self.raw.clear()
+        self.native.clear()
+
+    def gradient_square(self, layer_index: int, role: str) -> torch.Tensor:
+        raw = self.raw[(layer_index, role)]
+        if raw.grad is None:
+            raise RuntimeError(f"no retained gradient for layer {layer_index} {role}")
+        return raw.grad.to(dtype=FISHER_DTYPE).square()
+
+    def remove(self) -> None:
+        for handle in self._handles:
+            handle.remove()
+        self._handles.clear()
+
+    def __enter__(self) -> "NativeKVHookCapture":
+        return self.install()
+
+    def __exit__(self, _exc_type: Any, _exc: Any, _traceback: Any) -> None:
+        self.remove()
+
+
+def load_frozen_token_tensors(
+    path: str | Path,
+    *,
+    num_examples: int,
+    sequence_length: int,
+) -> torch.Tensor:
+    token_path = Path(path)
+    if token_path.suffix == ".safetensors":
+        from safetensors.torch import load_file
+
+        payload: Any = load_file(str(token_path), device="cpu")
+    else:
+        payload = torch.load(
+            token_path,
+            map_location="cpu",
+            weights_only=True,
+        )
+    if isinstance(payload, dict):
+        if set(payload) != {"input_ids"}:
+            raise ValueError("token tensor mapping must contain only input_ids")
+        token_ids = payload["input_ids"]
+    else:
+        token_ids = payload
+    if not isinstance(token_ids, torch.Tensor):
+        raise TypeError("token artifact must contain a torch.Tensor")
+    if token_ids.dtype != torch.int64:
+        raise ValueError(f"token IDs must use torch.int64, got {token_ids.dtype}")
+    expected_shape = (num_examples, sequence_length)
+    if tuple(token_ids.shape) != expected_shape:
+        raise ValueError(
+            f"token IDs must have exact shape {expected_shape}, got {tuple(token_ids.shape)}"
+        )
+    return token_ids.detach().cpu().contiguous()
+
+
+def _read_fisher_safetensors(path: str | Path) -> dict[str, torch.Tensor]:
+    fisher_path = Path(path)
+    if fisher_path.name != "fisher.safetensors":
+        raise ValueError("Fisher input must be the exact fisher.safetensors artifact")
+    if not fisher_path.is_file():
+        raise FileNotFoundError(fisher_path)
+    from safetensors.torch import load_file
+
+    fisher = load_file(str(fisher_path), device="cpu")
+    return fisher
+
+
+def _expected_fisher_names(layer_indices: Iterable[int]) -> set[str]:
+    return {
+        f"model.layers.{layer_index}.self_attn.{projection}.weight"
+        for layer_index in layer_indices
+        for projection in ("k_proj", "v_proj")
+    }
+
+
+def _validate_fisher_tensors(
+    fisher: dict[str, torch.Tensor],
+    *,
+    layer_indices: Iterable[int],
+    num_examples: int,
+    sequence_length: int,
+) -> dict[str, torch.Tensor]:
+    if (
+        not isinstance(num_examples, int)
+        or isinstance(num_examples, bool)
+        or num_examples <= 0
+    ):
+        raise ValueError("Fisher num_examples must be a positive integer")
+    if (
+        not isinstance(sequence_length, int)
+        or isinstance(sequence_length, bool)
+        or sequence_length <= 0
+    ):
+        raise ValueError("Fisher sequence_length must be a positive integer")
+    expected_names = _expected_fisher_names(layer_indices)
+    actual_names = set(fisher)
+    if actual_names != expected_names:
+        missing = sorted(expected_names - actual_names)
+        unexpected = sorted(actual_names - expected_names)
+        raise ValueError(
+            "Fisher layer/role coverage mismatch: "
+            f"missing={missing!r}, unexpected={unexpected!r}"
+        )
+    expected_shape = (1, num_examples * sequence_length, 1024)
+    for name in sorted(expected_names):
+        tensor = fisher[name]
+        if tensor.dtype != FISHER_DTYPE:
+            raise ValueError(f"Fisher tensor {name!r} must use float32")
+        if tuple(tensor.shape) != expected_shape:
+            raise ValueError(
+                f"Fisher tensor {name!r} must have native-GQA shape "
+                f"{expected_shape}, got {tuple(tensor.shape)}"
+            )
+        if not torch.isfinite(tensor).all():
+            raise ValueError(f"Fisher tensor {name!r} contains non-finite values")
+    return fisher
+
+
+def validate_full_fisher_tensors(
+    fisher: dict[str, torch.Tensor],
+    *,
+    num_examples: int,
+    sequence_length: int,
+) -> dict[str, torch.Tensor]:
+    """Validate the only Fisher payload accepted by full Phase 9 calibration."""
+
+    return _validate_fisher_tensors(
+        fisher,
+        layer_indices=range(32),
+        num_examples=num_examples,
+        sequence_length=sequence_length,
+    )
+
+
+def load_fisher_artifact(
+    path: str | Path,
+    *,
+    num_examples: int = 16,
+    sequence_length: int = 2048,
+) -> dict[str, torch.Tensor]:
+    fisher = _read_fisher_safetensors(path)
+    return validate_full_fisher_tensors(
+        fisher,
+        num_examples=num_examples,
+        sequence_length=sequence_length,
+    )
+
+
+def load_fisher_smoke_artifact(
+    path: str | Path,
+    *,
+    layer_index: int = 0,
+    num_examples: int = 1,
+    sequence_length: int = 8,
+) -> dict[str, torch.Tensor]:
+    """Validate only the one-layer Phase 9P smoke artifact, never a full input."""
+
+    if not isinstance(layer_index, int) or isinstance(layer_index, bool):
+        raise TypeError("smoke Fisher layer_index must be an integer")
+    if not 0 <= layer_index < 32:
+        raise ValueError("smoke Fisher layer_index must be in [0, 31]")
+    fisher = _read_fisher_safetensors(path)
+    return _validate_fisher_tensors(
+        fisher,
+        layer_indices=(layer_index,),
+        num_examples=num_examples,
+        sequence_length=sequence_length,
+    )
