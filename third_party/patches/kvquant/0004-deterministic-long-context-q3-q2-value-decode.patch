+template <int BITS, int LEVELS, int PACKED_ROWS>
+__global__ void VecQuantQ23MatMulKernelNUQPerChannelTransposedMHABatchedFusedOptDeterministicTiles(
+    const float* __restrict__ vec,
+    const int* __restrict__ mat,
+    const float* __restrict__ lookup_table,
+    const float* __restrict__ outliers,
+    const int* __restrict__ outlier_indices,
+    float* __restrict__ workspace,
+    int width,
+    int fullwidth,
+    int headdim,
+    int num_query_heads,
+    int num_kv_groups,
+    int num_outliers,
+    int workspace_tiles,
+    int64_t vec_batch_stride,
+    int64_t vec_head_stride,
+    int64_t workspace_batch_stride,
+    int64_t workspace_head_stride,
+    int64_t workspace_tile_stride
+) {
+  const int channel = threadIdx.x;
+  const int tile = blockIdx.x;
+  const int query_head = blockIdx.y;
+  const int batch = blockIdx.z;
+
+  const int64_t workspace_offset =
+      batch * workspace_batch_stride +
+      query_head * workspace_head_stride +
+      tile * workspace_tile_stride +
+      channel;
+  workspace[workspace_offset] =
+      VecQuantQ23DeterministicTilePartial<BITS, LEVELS, PACKED_ROWS>(
+          vec,
+          mat,
+          lookup_table,
+          outliers,
+          outlier_indices,
+          width,
+          fullwidth,
+          headdim,
+          num_query_heads,
+          num_kv_groups,
+          num_outliers,
+          vec_batch_stride,
+          vec_head_stride,
+          batch,
+          query_head,
+          tile,
+          channel
+      );
+}
