+                native_key, native_value = self._run_dense(
+                    bits, mat, key_lut, value_lut, query, scores
+                )
+
+                # Explicit physical repetition is permitted only in this independent test.
+                repeated_mat = mat.repeat_interleave(self.groups, dim=0).contiguous()
+                repeated_key_lut = key_lut.repeat_interleave(
+                    self.groups, dim=0
+                ).contiguous()
+                reference_key, reference_value = self._run_dense(
