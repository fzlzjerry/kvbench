+namespace {
+
+constexpr int kMeasurementWidth = 1024;
+constexpr int kSparseCapacity = 12;
+constexpr int kEntriesPerTail = 6;
+constexpr int kHeadDim = 128;
+constexpr int kNumKvHeads = 8;
+
+enum SelectionMode : int {
+  kKeyThresholded = 0,
+  kValueFixedExtrema = 1,
+};
+
+void check_cuda_contiguous(const torch::Tensor& tensor, const char* name) {
+  TORCH_CHECK(tensor.is_cuda(), name, " must be a CUDA tensor");
+  TORCH_CHECK(tensor.is_contiguous(), name, " must be contiguous");
+}
+
+void check_same_device(
+    const torch::Tensor& reference,
+    const torch::Tensor& tensor,
+    const char* name) {
+  TORCH_CHECK(
+      tensor.get_device() == reference.get_device(),
+      name,
+      " must be on the same CUDA device as the input");
+}
+
+__device__ bool already_selected(
+    const int* selected_indices,
+    int selected_count,
+    int candidate) {
+  for (int slot = 0; slot < selected_count; ++slot) {
+    if (selected_indices[slot] == candidate) {
+      return true;
+    }
+  }
+  return false;
+}
