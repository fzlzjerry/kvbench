+def run_non_default_stream(quant_cuda, root: Path) -> None:
+    operation, tensors, _ = graph_inputs(quant_cuda, root)
+    stream = torch.cuda.Stream()
+    ready = torch.cuda.Event()
+    done = torch.cuda.Event()
+    ready.record(torch.cuda.current_stream())
+    stream.wait_event(ready)
+    with torch.cuda.stream(stream):
+        operation()
+        done.record(stream)
+    torch.cuda.current_stream().wait_event(done)
+    torch.cuda.synchronize()
+    if int(tensors[9][STORE_QUANTIZED].item()) != CAP:
+        raise AssertionError("non-default-stream operation did not complete in order")
+    print("PASS non-default CUDA stream ordering", flush=True)
