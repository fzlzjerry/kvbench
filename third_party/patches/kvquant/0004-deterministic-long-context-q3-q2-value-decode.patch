+                    sparsity_threshold=0.99,
+                    nuq=True,
+                    fisher=fisher,
+                    cap_outliers=12,
+                    first_few_fp16=5,
+                )
+            lower, upper, centroids = result
+            self.assertEqual(torch.as_tensor(lower).dtype, torch.float32)
+            self.assertEqual(torch.as_tensor(upper).dtype, torch.float32)
+            self.assertTrue(torch.isfinite(torch.as_tensor(lower)).all())
+            self.assertTrue(torch.isfinite(torch.as_tensor(upper)).all())
+            self.assertTrue(
+                all(torch.isfinite(torch.from_numpy(centroid)).all() for centroid in centroids)
+            )
+            self.assertTrue(all(str(centroid.dtype) == "float32" for centroid in centroids))
+            self.assertEqual(quantizer.out.dtype, torch.float16)
+            payload = build_quantizer_payload(
+                {"model.layers.0.self_attn.k_proj": result},
+                bit_width=4,
+                patched_commit="a" * 40,
+                patched_tree="b" * 40,
+                patch_digest="c" * 64,
+                fisher_root=fisher_root,
+                dataset_root="d" * 64,
+                token_tensor_sha256="e" * 64,
+                seed=20260721,
+                num_examples=1,
+                sequence_length=8,
+            )
+            self.assertEqual(payload["format"], "kvquant_gqa_quantizer_v1")
+            self.assertEqual(
+                payload["provenance"]["method_identifier"],
+                "kvquant_gqa_upstream_patch_v1",
+            )
+            self.assertEqual(payload["provenance"]["bit_width"], 4)
+            self.assertEqual(payload["provenance"]["key_outlier_cap"], 12)
+            self.assertEqual(payload["provenance"]["value_outlier_cap"], 12)
+            self.assertEqual(payload["provenance"]["sink_tokens"], 5)
+        finally:
+            sys.path.remove(quant_root)
+
