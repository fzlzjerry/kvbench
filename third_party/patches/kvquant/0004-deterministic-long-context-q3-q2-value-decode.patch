+
+
+def _valid_quantizer_envelope(bit_width: int = 4):
+    num_examples = 16
+    sequence_length = 2048
+    quantizers = {}
+    for layer in range(32):
+        for role in ("k", "v"):
+            name = f"model.layers.{layer}.self_attn.{role}_proj"
+            threshold_shape = (
+                (1, 1024) if role == "k" else (num_examples * sequence_length, 1)
+            )
+            upper = torch.ones(threshold_shape, dtype=torch.float32)
+            lower = -torch.ones(threshold_shape, dtype=torch.float32)
+            codebook = [
+                torch.linspace(-1, 1, 1 << bit_width, dtype=torch.float32).reshape(-1, 1)
+            ]
+            quantizers[name] = (upper, lower, codebook)
+    expected = {
+        "patched_commit": "1" * 40,
+        "patched_tree": "2" * 40,
+        "patch_digest": "3" * 64,
+        "fisher_root": "4" * 64,
+        "dataset_root": "5" * 64,
+        "token_tensor_sha256": "6" * 64,
+        "seed": 20260721,
+        "num_examples": num_examples,
+        "sequence_length": sequence_length,
+    }
+    payload = build_quantizer_payload(
+        quantizers,
+        bit_width=bit_width,
+        patched_commit=expected["patched_commit"],
+        patched_tree=expected["patched_tree"],
+        patch_digest=expected["patch_digest"],
+        fisher_root=expected["fisher_root"],
+        dataset_root=expected["dataset_root"],
+        token_tensor_sha256=expected["token_tensor_sha256"],
+        seed=expected["seed"],
+        num_examples=num_examples,
+        sequence_length=sequence_length,
+    )
+    return payload, expected
+
+
+class DeploymentSourceTests(unittest.TestCase):
+    def test_eager_path_retains_native_kv_cache_and_sink_geometry(self) -> None:
+        source = DEPLOYMENT_SOURCE.read_text()
+        eager = source[source.index("class LlamaAttention") : source.index("class LlamaFlashAttention2")]
+        self.assertIn("self.num_key_value_heads", eager)
+        self.assertIn("self.num_key_value_groups", eager)
+        self.assertIn("self.kcache_fp16", eager)
+        self.assertIn("self.vcache_fp16", eager)
