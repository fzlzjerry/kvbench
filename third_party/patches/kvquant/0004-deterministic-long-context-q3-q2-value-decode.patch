+    def test_mha_groups_one_matches_direct_unpacked_4_3_2_bit_reference(self) -> None:
+        heads = 2
+        channels = torch.arange(self.head_dim, device=self.device)
+        for bits in (4, 3, 2):
+            with self.subTest(bits=bits):
+                packed_rows = bits * self.head_dim // 32
+                levels = 1 << bits
+                mat = torch.randint(
+                    -(2**31),
+                    2**31 - 1,
+                    (heads, packed_rows, self.sequence),
+                    dtype=torch.int32,
+                    device=self.device,
+                )
+                key_lut = torch.randn(
+                    heads, self.head_dim, levels, device=self.device
+                )
+                value_lut = torch.randn(
+                    self.sequence, levels, device=self.device
+                )
+                query = torch.randn(
+                    1, heads, self.head_dim, device=self.device
+                )
+                scores = torch.randn(
+                    1, heads, self.sequence, device=self.device
+                )
+                key_output, value_output = self._run_dense(
+                    bits, mat, key_lut, value_lut, query, scores
+                )
+
+                packed_cpu = mat.cpu()
+                unpacked_codes = torch.empty(
+                    heads,
+                    self.head_dim,
+                    self.sequence,
+                    dtype=torch.long,
+                )
+                mask = (1 << bits) - 1
+                for head in range(heads):
+                    for channel in range(self.head_dim):
+                        bit_offset = channel * bits
+                        word_row = bit_offset // 32
+                        shift = bit_offset % 32
+                        for token in range(self.sequence):
+                            code = (
+                                int(packed_cpu[head, word_row, token].item())
+                                & 0xFFFFFFFF
+                            ) >> shift
+                            if shift + bits > 32:
+                                next_word = (
+                                    int(packed_cpu[head, word_row + 1, token].item())
+                                    & 0xFFFFFFFF
+                                )
+                                code |= next_word << (32 - shift)
+                            unpacked_codes[head, channel, token] = code & mask
+                unpacked_codes = unpacked_codes.to(self.device)
+
+                expected_key = torch.zeros_like(key_output)
+                expected_value = torch.zeros_like(value_output)
+                half = self.head_dim // 2
+                for head in range(heads):
+                    for token in range(self.sequence):
+                        codes = unpacked_codes[head, :, token]
+                        key_values = key_lut[head, channels, codes]
+                        theta = self.inv_freq[channels % half] * (token + 5)
+                        partner = (channels + half) % self.head_dim
+                        sign = torch.where(channels < half, 1.0, -1.0)
+                        expected_key[0, head, token] = torch.sum(
+                            key_values
+                            * (
+                                torch.cos(theta) * query[0, head, channels]
+                                + sign
+                                * torch.sin(theta)
+                                * query[0, head, partner]
+                            )
+                        )
+                        expected_value[0, head] += (
+                            value_lut[token, codes] * scores[0, head, token]
+                        )
+                torch.testing.assert_close(
+                    key_output, expected_key, rtol=2e-5, atol=3e-4
+                )
+                torch.testing.assert_close(
+                    value_output, expected_value, rtol=2e-5, atol=3e-4
+                )
