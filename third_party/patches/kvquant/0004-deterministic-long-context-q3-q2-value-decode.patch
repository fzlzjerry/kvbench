+class Projection(nn.Module):
+    def __init__(self, width: int) -> None:
+        super().__init__()
+        self.width = width
+
+    def forward(self, hidden_states: torch.Tensor) -> torch.Tensor:
+        return hidden_states[..., : self.width]
+
+
+class Attention(nn.Module):
+    def __init__(self, geometry: GQAGeometry) -> None:
+        super().__init__()
+        self.q_proj = Projection(geometry.hidden_size)
+        self.k_proj = Projection(geometry.kv_width)
+        self.v_proj = Projection(geometry.kv_width)
+
+
+class Layer(nn.Module):
+    def __init__(self, geometry: GQAGeometry) -> None:
+        super().__init__()
+        self.self_attn = Attention(geometry)
