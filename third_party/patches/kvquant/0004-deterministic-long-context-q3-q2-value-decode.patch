+    def _dense_inputs(self, bits: int):
+        packed_rows = bits * self.head_dim // 32
+        levels = 1 << bits
+        mat = torch.randint(
+            -(2**31),
+            2**31 - 1,
+            (self.kv_heads, packed_rows, self.sequence),
+            dtype=torch.int32,
+            device=self.device,
+        )
+        key_lut = torch.randn(
+            self.kv_heads, self.head_dim, levels, device=self.device
+        )
+        value_lut = torch.randn(self.sequence, levels, device=self.device)
+        query = torch.randn(
+            1, self.query_heads, self.head_dim, device=self.device
+        )
+        scores = torch.randn(
+            1, self.query_heads, self.sequence, device=self.device
+        )
+        return mat, key_lut, value_lut, query, scores
+
+    def _run_dense(self, bits: int, mat, key_lut, value_lut, query, scores):
+        key_output = torch.zeros(
+            1, query.shape[1], self.sequence, device=self.device
+        )
+        value_output = torch.zeros(
+            1, scores.shape[1], self.head_dim, device=self.device
+        )
+        getattr(
+            quant_cuda,
+            f"vecquant{bits}matmul_nuq_perchannel_transposed_rope_mha_batched_fused_opt",
+        )(
+            query,
+            mat,
+            key_output,
+            key_lut,
+            self.sequence,
+            self.inv_freq,
+            5,
+        )
+        getattr(
+            quant_cuda,
+            f"vecquant{bits}matmul_nuq_perchannel_transposed_mha_batched_fused_opt",
+        )(scores, mat, value_output, value_lut, self.sequence)
+        torch.cuda.synchronize()
+        return key_output, value_output
