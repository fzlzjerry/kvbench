+
+def file_sha256(path: str | Path) -> str:
+    artifact_path = Path(path)
+    _reject_forbidden_authority_path(artifact_path, "checksum artifact")
+    artifact_path = artifact_path.resolve(strict=True)
+    _reject_forbidden_authority_path(artifact_path, "checksum artifact")
+    digest = hashlib.sha256()
+    with artifact_path.open("rb") as handle:
+        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _require_hex(name: str, value: str, length: int) -> str:
+    if len(value) != length or any(character not in "0123456789abcdef" for character in value):
+        raise ValueError(f"{name} must be a lowercase {length}-character hex identity")
+    return value
+
+
+def build_quantizer_payload(
+    quantizers: dict[str, Any],
+    *,
+    bit_width: int,
+    patched_commit: str,
+    patched_tree: str,
+    patch_digest: str,
+    fisher_root: str,
+    dataset_root: str,
+    token_tensor_sha256: str,
+    seed: int,
+    num_examples: int,
+    sequence_length: int,
+) -> dict[str, Any]:
+    if bit_width not in {2, 3, 4}:
+        raise ValueError("quantizer payload bit width must be 2, 3, or 4")
+    if not quantizers:
+        raise ValueError("quantizer payload cannot be empty")
+    if not isinstance(seed, int) or isinstance(seed, bool) or seed < 0:
+        raise ValueError("quantizer payload seed must be a non-negative integer")
+    if (
+        not isinstance(num_examples, int)
+        or isinstance(num_examples, bool)
+        or num_examples <= 0
+    ):
+        raise ValueError("quantizer payload num_examples must be a positive integer")
+    if (
+        not isinstance(sequence_length, int)
+        or isinstance(sequence_length, bool)
+        or sequence_length <= 0
+    ):
+        raise ValueError("quantizer payload sequence_length must be a positive integer")
+    provenance = {
+        "method_identifier": METHOD_IDENTIFIER,
+        "model_id": FROZEN_MODEL_ID,
+        "model_revision": FROZEN_MODEL_REVISION,
+        "tokenizer_id": FROZEN_TOKENIZER_ID,
+        "tokenizer_revision": FROZEN_TOKENIZER_REVISION,
+        "upstream_base_commit": UPSTREAM_BASE_COMMIT,
+        "upstream_base_tree": UPSTREAM_BASE_TREE,
+        "patched_commit": _require_hex("patched_commit", patched_commit, 40),
+        "patched_tree": _require_hex("patched_tree", patched_tree, 40),
+        "patch_digest": _require_hex("patch_digest", patch_digest, 64),
+        "fisher_root": _require_hex("fisher_root", fisher_root, 64),
+        "dataset_root": _require_hex("dataset_root", dataset_root, 64),
+        "token_tensor_sha256": _require_hex(
+            "token_tensor_sha256", token_tensor_sha256, 64
+        ),
+        "bit_width": bit_width,
+        "model_forward_dtype": "bfloat16",
+        "fisher_dtype": "float32",
+        "fitting_dtype": "float16",
+        "nuq": True,
+        "dense_and_sparse": True,
+        "sparsity_threshold": 0.99,
+        "key_outlier_cap": 12,
+        "value_outlier_cap": 12,
+        "sink_tokens": SINK_TOKENS,
+        "seed": seed,
+        "num_examples": num_examples,
+        "sequence_length": sequence_length,
+    }
+    return {
+        "format": "kvquant_gqa_quantizer_v1",
+        "provenance": provenance,
+        "quantizers": quantizers,
+    }
+
+
+def seed_calibration(seed: int) -> None:
+    if not isinstance(seed, int) or isinstance(seed, bool) or seed < 0:
+        raise ValueError("calibration seed must be a non-negative integer")
+    random.seed(seed)
+    try:
+        import numpy as np
+
+        np.random.seed(seed)
+    except ImportError:
+        pass
+    torch.manual_seed(seed)
+    if torch.cuda.is_available():
+        torch.cuda.manual_seed_all(seed)
+
+
+def resolve_fixed_outlier_cap(
+    geometry: GQAGeometry,
+    *,
+    total_outlier_fraction: float = 0.01,
+    tail_fraction: float = 0.005,
+) -> tuple[int, int]:
+    if not math.isclose(
+        total_outlier_fraction,
+        2.0 * tail_fraction,
+        rel_tol=0.0,
+        abs_tol=1e-12,
+    ):
+        raise ValueError("total_outlier_fraction must equal two tail fractions")
+    if not 0.0 < tail_fraction < 0.5:
+        raise ValueError("tail_fraction must lie strictly between zero and one half")
+    entries_per_tail = math.ceil(tail_fraction * geometry.kv_width)
+    fixed_total_cap = 2 * entries_per_tail
+    if fixed_total_cap > geometry.kv_width:
+        raise ValueError("resolved outlier cap exceeds native KV width")
+    return entries_per_tail, fixed_total_cap
+
+
+def _validate_cap(cap: int, width: int) -> int:
+    if not isinstance(cap, int) or isinstance(cap, bool):
+        raise TypeError("cap_outliers must be an integer")
+    if cap <= 0 or cap >= width or cap % 2:
+        raise ValueError("cap_outliers must be a positive even integer smaller than KV width")
+    return cap // 2
+
+
+def _broadcast_threshold(
+    threshold: torch.Tensor | float | None,
+    values: torch.Tensor,
+) -> torch.Tensor | None:
+    if threshold is None:
+        return None
+    tensor = torch.as_tensor(threshold, dtype=torch.float32, device=values.device)
+    return torch.broadcast_to(tensor, values.shape)
+
+
+def select_fixed_outliers(
+    values: torch.Tensor,
+    *,
+    cap: int,
+    lower_threshold: torch.Tensor | float | None = None,
+    upper_threshold: torch.Tensor | float | None = None,
+    sink_row_mask: torch.Tensor | None = None,
+) -> FixedSparseSelection:
+    """Select deterministic lower/upper sparse entries along the last dimension."""
+
+    if values.ndim < 1:
+        raise ValueError("outlier input must have at least one dimension")
+    if not torch.isfinite(values).all():
+        raise ValueError("outlier input contains non-finite values")
+    width = values.shape[-1]
+    entries_per_tail = _validate_cap(cap, width)
+    rows = values.to(dtype=torch.float32).reshape(-1, width)
+    lower = _broadcast_threshold(lower_threshold, values.to(dtype=torch.float32))
+    upper = _broadcast_threshold(upper_threshold, values.to(dtype=torch.float32))
+    lower_rows = None if lower is None else lower.reshape(-1, width)
+    upper_rows = None if upper is None else upper.reshape(-1, width)
+
+    if sink_row_mask is None:
+        sink_rows = torch.zeros(rows.shape[0], dtype=torch.bool, device=rows.device)
+    else:
+        sink_rows = torch.broadcast_to(
+            torch.as_tensor(sink_row_mask, dtype=torch.bool, device=rows.device),
+            values.shape[:-1],
+        ).reshape(-1)
+
+    selected_values = torch.zeros(
+        (rows.shape[0], cap), dtype=torch.float32, device=rows.device
+    )
+    selected_indices = torch.zeros(
+        (rows.shape[0], cap), dtype=torch.int32, device=rows.device
+    )
+    counts = torch.zeros(rows.shape[0], dtype=torch.int32, device=rows.device)
+    dense_lower_bound = torch.zeros(rows.shape[0], dtype=torch.float32, device=rows.device)
+    dense_upper_bound = torch.zeros(rows.shape[0], dtype=torch.float32, device=rows.device)
+
+    for row_index, row in enumerate(rows):
+        row_is_eligible = ~sink_rows[row_index]
+        lower_eligible = (
+            torch.ones(width, dtype=torch.bool, device=row.device)
+            if lower_rows is None
+            else row < lower_rows[row_index]
+        )
+        lower_eligible &= row_is_eligible
+        lower_indices = torch.nonzero(lower_eligible, as_tuple=False).flatten()
+        lower_order = torch.argsort(
+            row[lower_indices], descending=False, stable=True
+        )
+        lower_indices = lower_indices[lower_order[:entries_per_tail]]
+
+        already_selected = torch.zeros(width, dtype=torch.bool, device=row.device)
+        already_selected[lower_indices] = True
+        upper_eligible = (
+            torch.ones(width, dtype=torch.bool, device=row.device)
+            if upper_rows is None
+            else row > upper_rows[row_index]
+        )
+        upper_eligible &= ~already_selected
+        upper_eligible &= row_is_eligible
+        upper_indices = torch.nonzero(upper_eligible, as_tuple=False).flatten()
+        upper_order = torch.argsort(
+            row[upper_indices], descending=True, stable=True
+        )
+        upper_indices = upper_indices[upper_order[:entries_per_tail]]
+
+        indices = torch.cat((lower_indices, upper_indices))
+        count = indices.numel()
+        selected_values[row_index, :count] = row[indices]
+        selected_indices[row_index, :count] = indices.to(dtype=torch.int32)
+        counts[row_index] = count
+        dense_mask = torch.ones(width, dtype=torch.bool, device=row.device)
+        dense_mask[indices] = False
+        dense_values = row[dense_mask]
+        dense_lower_bound[row_index] = dense_values.min()
+        dense_upper_bound[row_index] = dense_values.max()
+
+    output_shape = values.shape[:-1] + (cap,)
+    return FixedSparseSelection(
+        values=selected_values.reshape(output_shape),
+        indices=selected_indices.reshape(output_shape),
+        counts=counts.reshape(values.shape[:-1]),
+        dense_lower_bound=dense_lower_bound.reshape(values.shape[:-1]),
+        dense_upper_bound=dense_upper_bound.reshape(values.shape[:-1]),
+    )
+
+
+def deterministic_fixed_outlier_mask(
+    values: torch.Tensor,
+    *,
+    cap: int,
+    lower_threshold: torch.Tensor | float,
+    upper_threshold: torch.Tensor | float,
+    sink_tokens: int = 0,
+) -> torch.Tensor:
+    if not isinstance(sink_tokens, int) or isinstance(sink_tokens, bool) or sink_tokens < 0:
+        raise ValueError("sink_tokens must be a non-negative integer")
+    if values.ndim != 2:
+        raise ValueError("runtime sparse selection expects [token, native_kv_width]")
+    sink_rows = torch.zeros(values.shape[0], dtype=torch.bool, device=values.device)
+    sink_rows[: min(sink_tokens, values.shape[0])] = True
+    selection = select_fixed_outliers(
+        values,
+        cap=cap,
+        lower_threshold=lower_threshold,
+        upper_threshold=upper_threshold,
+        sink_row_mask=sink_rows,
+    )
+    mask = torch.zeros_like(values, dtype=torch.bool)
+    slots = torch.arange(cap, device=values.device).unsqueeze(0)
+    valid = slots < selection.counts.unsqueeze(1)
+    row_indices = torch.arange(values.shape[0], device=values.device)
+    row_indices = row_indices.unsqueeze(1).expand_as(valid)
+    mask[
+        row_indices[valid],
+        selection.indices.to(dtype=torch.int64)[valid],
+    ] = True
+    return mask
