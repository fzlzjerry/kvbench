+        quant_cuda.append_value_sparse_1024_cap12_out(
+            dense,
+            lookup,
+            value.reshape(WIDTH),
+            metadata_row,
+            dense_lower,
+            dense_upper,
+            zero_point,
+            selected_values.reshape(CAP),
+            selected_indices.reshape(CAP),
+            counts,
+            sparse_out,
+            indices_out,
+            counts_out,
+            STORE_QUANTIZED,
+            4,
+        )
+        output.zero_()
+        quant_cuda.vecquant4matmul_nuq_perchannel_transposed_mha_batched_fused_opt2(
+            scores,
+            dense,
+            output,
+            lookup,
+            QUANTIZED,
+            sparse_out,
+            indices_out,
+        )
+
+    operation()
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        operation()
+    graph.replay()
+    torch.cuda.synchronize()
+    graph.reset()
+    del graph, operation
+    del (
+        value,
+        dummy,
+        sink,
+        selected_values,
+        selected_indices,
+        counts,
+        dense_lower,
+        dense_upper,
+        dense,
+        lookup,
+        sparse_out,
+        indices_out,
+        counts_out,
+        metadata_row,
+        zero_point,
+        scores,
+        output,
+    )
+    gc.collect()
+    print("PASS sanitizer graph selector->append->decode", flush=True)
+
+
+def run_sanitizer_case(quant_cuda, root: Path, case: str) -> None:
+    if case == "graph":
+        run_sanitizer_graph(quant_cuda)
+        return
+    values = torch.zeros((1, WIDTH), dtype=torch.float32, device="cuda")
+    lower = torch.full((WIDTH,), -1.0, dtype=torch.float32, device="cuda")
+    upper = torch.full((WIDTH,), 1.0, dtype=torch.float32, device="cuda")
+    sink_mask = torch.tensor([case == "sink"], dtype=torch.bool, device="cuda")
+    if case == "key12":
+        values[0, :6] = -2.0
+        values[0, WIDTH - 6 :] = 2.0
+    elif case == "value12":
+        values.copy_(
+            torch.arange(WIDTH, dtype=torch.float32, device="cuda").reshape(1, WIDTH)
+        )
+    mode = 1 if case in ("value12", "sink") else 0
+    outputs = selector_outputs(
+        quant_cuda,
+        values,
+        lower,
+        upper,
+        sink_mask,
+        mode,
+    )
+    torch.cuda.synchronize()
+    del outputs, values, lower, upper, sink_mask
+    print(f"PASS sanitizer case {case}", flush=True)
+
+
+def release_cuda_test_state() -> None:
+    """Release framework caches so memcheck leak results cover the tested APIs."""
+
+    torch.cuda.synchronize()
+    gc.collect()
+    if hasattr(torch._C, "_cuda_clearCublasWorkspaces"):
+        torch._C._cuda_clearCublasWorkspaces()
+    torch.cuda.empty_cache()
+    if hasattr(torch._C, "_host_emptyCache"):
+        torch._C._host_emptyCache()
+    torch.cuda.synchronize()
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument(
+        "mode",
+        choices=("fixtures", "graph", "stream", "allocation", "sanitizer"),
+    )
+    parser.add_argument(
+        "--fixture-root",
+        type=Path,
+        required=True,
+    )
+    parser.add_argument(
+        "--case",
+        choices=("key0", "key12", "value12", "sink", "graph"),
+    )
+    arguments = parser.parse_args()
+    if not torch.cuda.is_available() or torch.cuda.get_device_capability() != (12, 0):
+        raise RuntimeError("Phase 11P requires native SM120 CUDA execution")
+    quant_cuda = importlib.import_module("quant_cuda")
+    if arguments.mode == "fixtures":
+        run_all_fixtures(quant_cuda, arguments.fixture_root)
+    elif arguments.mode == "graph":
+        run_graph(quant_cuda, arguments.fixture_root)
+    elif arguments.mode == "stream":
+        run_non_default_stream(quant_cuda, arguments.fixture_root)
+    elif arguments.mode == "allocation":
+        run_allocation(quant_cuda, arguments.fixture_root)
+    else:
+        if arguments.case is None:
+            parser.error("--case is required for sanitizer mode")
+        run_sanitizer_case(quant_cuda, arguments.fixture_root, arguments.case)
+        release_cuda_test_state()
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
