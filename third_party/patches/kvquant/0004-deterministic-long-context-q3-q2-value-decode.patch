+    def test_loader_is_exact_offline_bf16_eager_and_provenance_bound(self) -> None:
+        source = (REPOSITORY_ROOT / "deployment" / "llama.py").read_text()
+        authority_source = (REPOSITORY_ROOT / "kvquant_gqa" / "compat.py").read_text()
+        for required in (
+            "FROZEN_MODEL_REVISION",
+            "FROZEN_TOKENIZER_REVISION",
+            "local_files_only=True",
+            'attn_implementation="eager"',
+            'config._attn_implementation = "eager"',
