@@ -0,0 +1,120 @@
+"""Grouped-query attention helpers that retain native KV-head storage."""
+
+from __future__ import annotations
+
+import torch
+
+
+def _validate_head_geometry(
+    *,
+    batch_size: int,
+    other_batch_size: int,
+    num_query_heads: int,
+    num_key_value_heads: int,
+    head_dim: int,
+    other_head_dim: int,
+) -> int:
+    if batch_size != other_batch_size:
+        raise ValueError(
+            "query/attention and key/value batch dimensions must match"
+        )
+    if head_dim != other_head_dim:
+        raise ValueError(
+            "query/attention and key/value head dimensions must match"
+        )
+    if num_key_value_heads <= 0:
+        raise ValueError("num_key_value_heads must be positive")
+    if num_query_heads % num_key_value_heads != 0:
+        raise ValueError(
+            "num_query_heads must be divisible by num_key_value_heads"
+        )
+    return num_query_heads // num_key_value_heads
+
+
+def gqa_query_key_matmul(
+    query_states: torch.Tensor,
+    key_states: torch.Tensor,
+) -> torch.Tensor:
+    """Compute QK scores without expanding K from H_KV to H_Q."""
+    if query_states.ndim != 4 or key_states.ndim != 4:
+        raise ValueError("query_states and key_states must be rank-4")
+
+    batch_size, num_query_heads, query_length, head_dim = query_states.shape
+    (
+        key_batch_size,
+        num_key_value_heads,
+        key_length,
+        key_head_dim,
+    ) = key_states.shape
+    num_key_value_groups = _validate_head_geometry(
+        batch_size=batch_size,
+        other_batch_size=key_batch_size,
+        num_query_heads=num_query_heads,
+        num_key_value_heads=num_key_value_heads,
+        head_dim=head_dim,
+        other_head_dim=key_head_dim,
+    )
+
+    grouped_queries = query_states.reshape(
+        batch_size * num_key_value_heads,
+        num_key_value_groups * query_length,
+        head_dim,
+    )
+    native_keys = key_states.reshape(
+        batch_size * num_key_value_heads,
+        key_length,
+        head_dim,
+    )
+    scores = torch.bmm(grouped_queries, native_keys.transpose(1, 2))
+    return scores.reshape(
+        batch_size,
+        num_key_value_heads,
+        num_key_value_groups,
+        query_length,
+        key_length,
+    ).reshape(batch_size, num_query_heads, query_length, key_length)
+
+
+def gqa_attention_value_matmul(
+    attention_weights: torch.Tensor,
+    value_states: torch.Tensor,
+) -> torch.Tensor:
+    """Apply attention weights without expanding V from H_KV to H_Q."""
+    if attention_weights.ndim != 4 or value_states.ndim != 4:
+        raise ValueError("attention_weights and value_states must be rank-4")
+
+    batch_size, num_query_heads, query_length, key_length = (
+        attention_weights.shape
+    )
+    value_batch_size, num_key_value_heads, value_length, head_dim = (
+        value_states.shape
+    )
+    if key_length != value_length:
+        raise ValueError("attention and value sequence lengths must match")
+    num_key_value_groups = _validate_head_geometry(
+        batch_size=batch_size,
+        other_batch_size=value_batch_size,
+        num_query_heads=num_query_heads,
+        num_key_value_heads=num_key_value_heads,
+        head_dim=head_dim,
+        other_head_dim=head_dim,
+    )
+
+    grouped_weights = attention_weights.reshape(
+        batch_size * num_key_value_heads,
+        num_key_value_groups * query_length,
+        key_length,
+    )
+    native_values = value_states.reshape(
+        batch_size * num_key_value_heads,
+        value_length,
+        head_dim,
+    )
+    output = torch.bmm(grouped_weights, native_values)
+    return output.reshape(
+        batch_size,
+        num_key_value_heads,
+        num_key_value_groups,
+        query_length,
+        head_dim,
+    ).reshape(batch_size, num_query_heads, query_length, head_dim)
